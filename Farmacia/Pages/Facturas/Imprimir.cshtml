@page "{id:int}"
@model Farmacia.Pages.Facturas.ImprimirModel
@{
    ViewData["Title"] = "Impresión de Factura";
}

<div class="container mt-4">

    <h3 class="fw-bold">Vista previa de factura</h3>
    <p class="text-muted">Factura No: @Model.Factura.IdFactura</p>

    <iframe src="/Facturas/Ticket?id=@Model.Factura.IdFactura"
            style="width:100%; height:600px; border:1px solid #ccc;">
    </iframe>

    <div class="mt-3 text-center">
        <button onclick="window.print()" class="btn btn-primary">🖨 Imprimir</button>
        <a href="/Facturas/Nueva" class="btn btn-secondary">↩ Nueva Factura</a>
    </div>
</div>
