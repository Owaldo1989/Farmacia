@page
@model Farmacia.Pages.Facturas.NuevaModel

@{
    ViewData["Title"] = "Nueva Venta";
}

<link rel="stylesheet"
      href="~/css/factura-nueva.css"
      asp-append-version="true" />


<div class="sale-page">


    <!-- =====================================================
         ENCABEZADO
    ====================================================== -->

    <section class="sale-header">

        <div>

            <div class="sale-eyebrow">
                <i class="bi bi-receipt-cutoff"></i>
                Punto de venta
            </div>

            <h1>Nueva venta</h1>

            <p>
                Registra los productos y procesa el pago del cliente.
            </p>

        </div>


        <div class="sale-date">

            <div class="sale-date-icon">
                <i class="bi bi-calendar3"></i>
            </div>

            <div>
                <span>Fecha de operación</span>

                <strong>
                    @Model.Factura.Fecha.ToString("dd/MM/yyyy HH:mm")
                </strong>
            </div>

        </div>

    </section>



    <!-- =====================================================
         CONTENEDOR PRINCIPAL
    ====================================================== -->

    <section class="sale-layout">


        <!-- =================================================
             PANEL IZQUIERDO
        ================================================== -->

        <div class="sale-products">


            <!-- BUSCADOR -->

            <div class="sale-toolbar">

                <button type="button"
                        class="btn-product-search"
                        onclick="abrirBuscador()">

                    <span class="search-icon">
                        <i class="bi bi-search"></i>
                    </span>

                    <span class="search-content">

                        <strong>
                            Buscar producto
                        </strong>

                        <small>
                            Nombre, código de barra, genérico...
                        </small>

                    </span>

                    <span class="keyboard-shortcut">
                        F2
                    </span>

                </button>

            </div>



            <!-- =================================================
                 DETALLE
            ================================================== -->

            <div class="sale-detail-card">


                <div class="detail-header">

                    <div>

                        <h2>
                            Detalle de la venta
                        </h2>

                        <p id="txtDetalleEstado">
                            Agrega productos para comenzar.
                        </p>

                    </div>


                    <div class="detail-count">

                        <i class="bi bi-basket2"></i>

                        <span id="lblCantidadProductos">
                            0
                        </span>

                    </div>

                </div>



                <!-- TABLA -->

                <div class="sale-table-container">

                    <table class="sale-table">

                        <thead>

                            <tr>

                                <th class="column-code">
                                    Código
                                </th>

                                <th>
                                    Producto
                                </th>

                                <th class="column-price">
                                    Precio
                                </th>

                                <th class="column-quantity">
                                    Cant.
                                </th>

                                <th class="column-subtotal">
                                    Subtotal
                                </th>

                                <th class="column-actions"></th>

                            </tr>

                        </thead>


                        <tbody id="detalleBody">
                        </tbody>

                    </table>



                    <!-- ESTADO VACÍO -->

                    <div class="empty-sale"
                         id="emptySale">

                        <div class="empty-sale-icon">
                            <i class="bi bi-basket2"></i>
                        </div>

                        <strong>
                            Aún no hay productos
                        </strong>

                        <span>
                            Presiona F2 o utiliza el buscador para agregar
                            productos a la venta.
                        </span>

                        <button type="button"
                                onclick="abrirBuscador()">

                            <i class="bi bi-plus-lg"></i>

                            Agregar producto

                        </button>

                    </div>

                </div>


            </div>


        </div>



        <!-- =================================================
             PANEL DERECHO
        ================================================== -->

        <aside class="sale-summary">


            <div class="summary-header">

                <div class="summary-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <div>
                    <h2>Resumen</h2>
                    <span>Venta actual</span>
                </div>

            </div>



            <div class="summary-information">


                <div class="summary-row">

                    <span>
                        Productos
                    </span>

                    <strong id="lblProductosResumen">
                        0
                    </strong>

                </div>


                <div class="summary-row">

                    <span>
                        Unidades
                    </span>

                    <strong id="lblUnidadesResumen">
                        0
                    </strong>

                </div>


            </div>



            <div class="summary-divider"></div>



            <!-- TOTAL -->

            <div class="summary-total">

                <span>
                    Total a pagar
                </span>

                <strong id="lblTotal">
                    C$ 0.00
                </strong>

                <small>
                    Córdobas
                </small>

            </div>



            <!-- PAGO -->

            <button type="button"
                    class="btn-register-payment"
                    onclick="abrirPago()">

                <i class="bi bi-cash-stack"></i>

                <span>
                    Registrar pago
                </span>

                <i class="bi bi-arrow-right"></i>

            </button>



            <div class="summary-security">

                <i class="bi bi-shield-check"></i>

                <span>
                    Verifica los productos antes de procesar el pago.
                </span>

            </div>


        </aside>


    </section>



    <!-- =====================================================
         FORMULARIO POST
    ====================================================== -->

    <form method="post"
          id="formFactura">


        <input type="hidden"
               asp-for="Factura.IdFacturaCliente"
               value="@Model.Factura.IdFacturaCliente" />


        <input type="hidden"
               asp-for="Factura.Fecha"
               value="@Model.Factura.Fecha.ToString("o")" />


        <input type="hidden"
               asp-for="Factura.Paciente"
               id="hdPaciente" />


        <input type="hidden"
               asp-for="Factura.PagoCordoba"
               id="hdPagoCordoba" />


        <input type="hidden"
               asp-for="Factura.PagoDolar"
               id="hdPagoDolar" />


        <input type="hidden"
               asp-for="Factura.Vuelto"
               id="hdVuelto" />


        <input type="hidden"
               asp-for="DetalleJson"
               id="hdDetalleJson" />


    </form>


</div>



<!-- =========================================================
     MODAL BUSCAR PRODUCTOS
========================================================== -->

<div class="modal fade"
     id="modalBuscarProducto"
     tabindex="-1">

    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content pharmacy-modal">


            <div class="modal-header pharmacy-modal-header">

                <div class="modal-title-container">

                    <div class="modal-title-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <div>

                        <h5>
                            Buscar producto
                        </h5>

                        <span>
                            Busca por nombre, código o principio activo.
                        </span>

                    </div>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>



            <div class="modal-body pharmacy-modal-body">


                <div class="product-search-box">


                    <i class="bi bi-search"></i>


                    <input id="txtBuscarProd"
                           type="text"
                           placeholder="Escribe el producto que deseas buscar..."
                           autocomplete="off"
                           onkeydown="if(event.key === 'Enter'){buscarProducto();}" />


                    <button type="button"
                            onclick="buscarProducto()">

                        Buscar

                    </button>


                </div>



                <div class="search-help">

                    <i class="bi bi-info-circle"></i>

                    Puedes buscar por nombre, genérico, recomendado o código
                    de barra.

                </div>



                <div id="resultadosProductos"
                     class="product-results">

                    <div class="search-empty">

                        <i class="bi bi-search"></i>

                        <strong>
                            Busca un producto
                        </strong>

                        <span>
                            Los resultados aparecerán aquí.
                        </span>

                    </div>

                </div>


            </div>


        </div>

    </div>

</div>



<!-- =========================================================
     MODAL CANTIDAD
========================================================== -->

<div class="modal fade"
     id="modalCantidad"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content pharmacy-modal">


            <div class="modal-header pharmacy-modal-header">

                <div class="modal-title-container">

                    <div class="modal-title-icon">
                        <i class="bi bi-plus-lg"></i>
                    </div>

                    <div>

                        <h5>
                            Agregar producto
                        </h5>

                        <span>
                            Define cantidad y precio.
                        </span>

                    </div>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>



            <div class="modal-body pharmacy-modal-body">


                <input type="hidden"
                       id="mdl_IdProducto" />

                <input type="hidden"
                       id="mdl_CodBarra" />



                <div class="modern-form-group">

                    <label>
                        Producto
                    </label>

                    <div class="modern-input readonly">

                        <i class="bi bi-capsule-pill"></i>

                        <input id="mdl_NombreProducto"
                               readonly />

                    </div>

                </div>



                <div class="modern-form-group">

                    <label>
                        Fecha de vencimiento
                    </label>

                    <div class="modern-input readonly">

                        <i class="bi bi-calendar-event"></i>

                        <input id="mdl_Vence"
                               readonly />

                    </div>

                </div>



                <div class="form-grid">


                    <div class="modern-form-group">

                        <label>
                            Precio C$
                        </label>

                        <div class="modern-input">

                            <span class="input-prefix">
                                C$
                            </span>

                            <input id="mdl_Precio"
                                   type="number"
                                   step="0.01"
                                   min="0" />

                        </div>

                    </div>



                    <div class="modern-form-group">

                        <label>
                            Cantidad
                        </label>

                        <div class="modern-input">

                            <i class="bi bi-box"></i>

                            <input id="mdl_Cantidad"
                                   type="number"
                                   step="1"
                                   min="1"
                                   value="1" />

                        </div>

                    </div>


                </div>


            </div>



            <div class="modal-footer pharmacy-modal-footer">

                <button type="button"
                        class="btn-secondary-modern"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>


                <button type="button"
                        class="btn-primary-modern"
                        onclick="agregarAlDetalle()">

                    <i class="bi bi-plus-lg"></i>

                    Agregar producto

                </button>

            </div>


        </div>

    </div>

</div>



<!-- =========================================================
     MODAL PAGO
========================================================== -->

<div class="modal fade"
     id="modalPago"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content pharmacy-modal payment-modal">


            <div class="modal-header pharmacy-modal-header">

                <div class="modal-title-container">

                    <div class="modal-title-icon payment">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <div>

                        <h5>
                            Registrar pago
                        </h5>

                        <span>
                            Completa la información de la venta.
                        </span>

                    </div>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>



            <div class="modal-body pharmacy-modal-body">


                <!-- TOTAL PAGO -->

                <div class="payment-total">

                    <span>
                        Total a pagar
                    </span>

                    <strong id="lblTotalPagoVisual">
                        C$ 0.00
                    </strong>

                </div>


                <input id="txtTotal"
                       type="hidden" />



                <!-- PACIENTE -->

                <div class="modern-form-group">

                    <label>
                        Paciente / Cliente
                    </label>

                    <div class="modern-input">

                        <i class="bi bi-person"></i>

                        <input id="txtPaciente"
                               type="text"
                               placeholder="Nombre del paciente"
                               autocomplete="off" />

                    </div>

                </div>



                <!-- PAGOS -->

                <div class="form-grid">


                    <div class="modern-form-group">

                        <label>
                            Pago en córdobas
                        </label>

                        <div class="modern-input">

                            <span class="input-prefix">
                                C$
                            </span>

                            <input id="txtPagoC"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   placeholder="0.00"
                                   oninput="calcularVuelto()" />

                        </div>

                    </div>



                    <div class="modern-form-group">

                        <label>
                            Pago en dólares
                        </label>

                        <div class="modern-input">

                            <span class="input-prefix">
                                $
                            </span>

                            <input id="txtPagoD"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   placeholder="0.00"
                                   oninput="calcularVuelto()" />

                        </div>

                    </div>


                </div>



                <!-- VUELTO -->

                <div class="change-box"
                     id="changeBox">

                    <div>

                        <span>
                            Vuelto
                        </span>

                        <small id="txtMensajeVuelto">
                            Ingresa el monto recibido
                        </small>

                    </div>


                    <strong id="lblVueltoVisual">
                        C$ 0.00
                    </strong>


                    <input id="txtVuelto"
                           type="hidden" />

                </div>


            </div>



            <div class="modal-footer pharmacy-modal-footer">

                <button type="button"
                        class="btn-secondary-modern"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>


                <button type="button"
                        class="btn-primary-modern"
                        id="btnGuardarFactura"
                        onclick="guardarFactura()">

                    <i class="bi bi-check-lg"></i>

                    Finalizar venta

                </button>

            </div>


        </div>

    </div>

</div>



@section Scripts {

    <script>

      
            const tasaCambio =
        @Model.TasaCambio.ToString(
                System.Globalization.CultureInfo.InvariantCulture
        );

        // =========================================================
        // BUSCADOR
        // =========================================================

        function abrirBuscador() {

            const input =
                document.getElementById("txtBuscarProd");

            input.value = "";

            document.getElementById(
                "resultadosProductos"
            ).innerHTML = `

                <div class="search-empty">

                    <i class="bi bi-search"></i>

                    <strong>
                        Busca un producto
                    </strong>

                    <span>
                        Los resultados aparecerán aquí.
                    </span>

                </div>
            `;


            const modal =
                new bootstrap.Modal(
                    document.getElementById(
                        "modalBuscarProducto"
                    )
                );

            modal.show();


            document
                .getElementById("modalBuscarProducto")
                .addEventListener(
                    "shown.bs.modal",
                    function () {

                        input.focus();

                    },
                    { once: true }
                );

        }



        // =========================================================
        // BUSCAR PRODUCTO
        // =========================================================

        function buscarProducto() {

            const filtro =
                document
                    .getElementById("txtBuscarProd")
                    .value
                    .trim();


            const contenedor =
                document.getElementById(
                    "resultadosProductos"
                );


            contenedor.innerHTML = `

                <div class="search-loading">

                    <div class="spinner-border spinner-border-sm"></div>

                    Buscando productos...

                </div>
            `;


            fetch(
                `?handler=BuscarProductos&filtro=${encodeURIComponent(filtro)}`
            )
            .then(r => {

                if (!r.ok)
                    throw new Error();

                return r.json();

            })
            .then(data => {


                if (!data || data.length === 0) {

                    contenedor.innerHTML = `

                        <div class="search-empty">

                            <i class="bi bi-box"></i>

                            <strong>
                                Sin resultados
                            </strong>

                            <span>
                                No encontramos productos con esa búsqueda.
                            </span>

                        </div>
                    `;

                    return;
                }


                let html = `

                    <div class="product-result-table-wrapper">

                        <table class="product-result-table">

                            <thead>

                                <tr>

                                    <th>Código</th>

                                    <th>Producto</th>

                                    <th>Precio</th>

                                    <th>Vence</th>

                                    <th>Stock</th>

                                    <th></th>

                                </tr>

                            </thead>

                            <tbody>
                `;


                data.forEach(p => {


                    const vence =
                        p.fechaVencimiento
                            ? new Date(
                                p.fechaVencimiento
                            ).toLocaleDateString()
                            : "N/A";


                    const nombreSeguro =
                        String(p.nombreProducto)
                            .replace(/\\/g, "\\\\")
                            .replace(/'/g, "\\'");


                    let stockClass =
                        "stock-normal";


                    if (p.inventario <= 0)
                        stockClass = "stock-zero";

                    else if (p.inventario <= 5)
                        stockClass = "stock-low";


                    html += `

                        <tr>

                            <td>

                                <span class="product-code">
                                    ${p.codBarra}
                                </span>

                            </td>


                            <td>

                                <div class="result-product">

                                    <div class="result-product-icon">
                                        <i class="bi bi-capsule-pill"></i>
                                    </div>

                                    <strong>
                                        ${p.nombreProducto}
                                    </strong>

                                </div>

                            </td>


                            <td>

                                <strong class="result-price">
                                    C$ ${Number(p.precioVenta).toFixed(2)}
                                </strong>

                            </td>


                            <td>
                                ${vence}
                            </td>


                            <td>

                                <span class="stock-badge ${stockClass}">
                                    ${p.inventario}
                                </span>

                            </td>


                            <td>

                                <button type="button"
                                        class="btn-add-result"
                                        onclick="abrirModalCantidad(
                                            ${p.idProducto},
                                            '${p.codBarra}',
                                            '${nombreSeguro}',
                                            '${vence}',
                                            ${p.precioVenta}
                                        )">

                                    <i class="bi bi-plus-lg"></i>

                                </button>

                            </td>

                        </tr>
                    `;

                });


                html += `

                            </tbody>

                        </table>

                    </div>
                `;


                contenedor.innerHTML =
                    html;

            })
            .catch(() => {

                contenedor.innerHTML = `

                    <div class="search-empty error">

                        <i class="bi bi-exclamation-circle"></i>

                        <strong>
                            No se pudo realizar la búsqueda
                        </strong>

                        <span>
                            Intenta nuevamente.
                        </span>

                    </div>
                `;

            });

        }



        // =========================================================
        // MODAL CANTIDAD
        // =========================================================

        function abrirModalCantidad(
            id,
            cod,
            nombre,
            vence,
            precio
        ) {

            document.getElementById(
                "mdl_IdProducto"
            ).value = id;


            document.getElementById(
                "mdl_CodBarra"
            ).value = cod;


            document.getElementById(
                "mdl_NombreProducto"
            ).value = nombre;


            document.getElementById(
                "mdl_Vence"
            ).value = vence;


            document.getElementById(
                "mdl_Precio"
            ).value =
                Number(precio).toFixed(2);


            document.getElementById(
                "mdl_Cantidad"
            ).value = 1;


            new bootstrap.Modal(
                document.getElementById(
                    "modalCantidad"
                )
            ).show();

        }



        // =========================================================
        // AGREGAR PRODUCTO
        // =========================================================

        function agregarAlDetalle() {

            const id =
                document.getElementById(
                    "mdl_IdProducto"
                ).value;


            const cod =
                document.getElementById(
                    "mdl_CodBarra"
                ).value;


            const nombre =
                document.getElementById(
                    "mdl_NombreProducto"
                ).value;


            const precio =
                parseFloat(
                    document.getElementById(
                        "mdl_Precio"
                    ).value
                );


            const cantidad =
                parseFloat(
                    document.getElementById(
                        "mdl_Cantidad"
                    ).value
                );


            if (
                !Number.isFinite(precio) ||
                precio <= 0
            ) {

                Swal.fire(
                    "Atención",
                    "El precio debe ser mayor que cero.",
                    "warning"
                );

                return;
            }


            if (
                !Number.isFinite(cantidad) ||
                cantidad <= 0
            ) {

                Swal.fire(
                    "Atención",
                    "La cantidad debe ser mayor que cero.",
                    "warning"
                );

                return;
            }



            const tbody =
                document.getElementById(
                    "detalleBody"
                );


            const existente =
                tbody.querySelector(
                    `tr[data-id='${id}']`
                );


            if (existente) {

                const cantInput =
                    existente.querySelector(
                        ".det-cantidad"
                    );


                cantInput.value =
                    (
                        parseFloat(
                            cantInput.value
                        ) +
                        cantidad
                    ).toFixed(2);


                recalcularFila(
                    null,
                    existente
                );

            }
            else {

                const subtotal =
                    precio * cantidad;


                const tr =
                    document.createElement(
                        "tr"
                    );


                tr.dataset.id = id;


                tr.innerHTML = `

                    <td class="col-codbarra">

                        <span class="detail-code">
                            ${cod}
                        </span>

                    </td>


                    <td class="col-nombre">

                        <div class="detail-product">

                            <span class="detail-product-icon">

                                <i class="bi bi-capsule-pill"></i>

                            </span>

                            <strong>
                                ${nombre}
                            </strong>

                        </div>

                    </td>


                    <td>

                        <div class="table-money-input">

                            <span>C$</span>

                            <input type="number"
                                   step="0.10"
                                   min="0"
                                   class="det-precio"
                                   value="${precio.toFixed(2)}" />

                        </div>

                    </td>


                    <td>

                        <input type="number"
                               step="1"
                               min="1"
                               class="det-cantidad table-number-input"
                               value="${cantidad.toFixed(2)}" />

                    </td>


                    <td class="det-subtotal">

                        C$ ${subtotal.toFixed(2)}

                    </td>


                    <td>

                        <button type="button"
                                class="btn-remove-product"
                                title="Quitar producto"
                                onclick="eliminarProducto(this)">

                            <i class="bi bi-trash3"></i>

                        </button>

                    </td>
                `;


                tbody.appendChild(tr);


                tr.querySelector(
                    ".det-precio"
                ).addEventListener(
                    "input",
                    e => recalcularFila(e, tr)
                );


                tr.querySelector(
                    ".det-cantidad"
                ).addEventListener(
                    "input",
                    e => recalcularFila(e, tr)
                );

            }


            recalcularTotal();


            const modal =
                bootstrap.Modal.getInstance(
                    document.getElementById(
                        "modalCantidad"
                    )
                );


            modal?.hide();

        }



        // =========================================================
        // ELIMINAR
        // =========================================================

        function eliminarProducto(button) {

            button
                .closest("tr")
                .remove();


            recalcularTotal();

        }



        // =========================================================
        // RECALCULAR FILA
        // =========================================================

        function recalcularFila(
            e,
            row
        ) {

            row =
                row ||
                e.target.closest("tr");


            const cantidad =
                parseFloat(
                    row.querySelector(
                        ".det-cantidad"
                    ).value
                ) || 0;


            const precio =
                parseFloat(
                    row.querySelector(
                        ".det-precio"
                    ).value
                ) || 0;


            row.querySelector(
                ".det-subtotal"
            ).innerText =
                "C$ " +
                (
                    cantidad *
                    precio
                ).toFixed(2);


            recalcularTotal();

        }



        // =========================================================
        // TOTAL
        // =========================================================

        function recalcularTotal() {

            let total = 0;

            let unidades = 0;


            const filas =
                document.querySelectorAll(
                    "#detalleBody tr"
                );


            filas.forEach(row => {


                const cantidad =
                    parseFloat(
                        row.querySelector(
                            ".det-cantidad"
                        ).value
                    ) || 0;


                const precio =
                    parseFloat(
                        row.querySelector(
                            ".det-precio"
                        ).value
                    ) || 0;


                total +=
                    cantidad *
                    precio;


                unidades +=
                    cantidad;

            });


            document.getElementById(
                "lblTotal"
            ).innerText =
                "C$ " +
                total.toFixed(2);


            document.getElementById(
                "lblCantidadProductos"
            ).innerText =
                filas.length;


            document.getElementById(
                "lblProductosResumen"
            ).innerText =
                filas.length;


            document.getElementById(
                "lblUnidadesResumen"
            ).innerText =
                unidades.toFixed(2)
                    .replace(".00", "");


            const empty =
                document.getElementById(
                    "emptySale"
                );


            const txtEstado =
                document.getElementById(
                    "txtDetalleEstado"
                );


            if (filas.length > 0) {

                empty.style.display =
                    "none";


                txtEstado.innerText =
                    `${filas.length} producto(s) agregado(s).`;

            }
            else {

                empty.style.display =
                    "flex";


                txtEstado.innerText =
                    "Agrega productos para comenzar.";

            }

        }



        // =========================================================
        // ABRIR PAGO
        // =========================================================

        function abrirPago() {

            const total =
                obtenerTotalActual();


            if (total <= 0) {

                Swal.fire(
                    "Atención",
                    "Debe agregar productos.",
                    "warning"
                );

                return;
            }


            document.getElementById(
                "txtTotal"
            ).value =
                total.toFixed(2);


            document.getElementById(
                "lblTotalPagoVisual"
            ).innerText =
                "C$ " +
                total.toFixed(2);


            document.getElementById(
                "txtPagoC"
            ).value = "";


            document.getElementById(
                "txtPagoD"
            ).value = "";


            document.getElementById(
                "txtVuelto"
            ).value = "0";


            document.getElementById(
                "lblVueltoVisual"
            ).innerText =
                "C$ 0.00";


            document.getElementById(
                "txtMensajeVuelto"
            ).innerText =
                "Ingresa el monto recibido";


            document.getElementById(
                "changeBox"
            ).className =
                "change-box";


            document.getElementById(
                "btnGuardarFactura"
            ).disabled =
                true;


            const modal =
                new bootstrap.Modal(
                    document.getElementById(
                        "modalPago"
                    )
                );


            modal.show();

        }



        function obtenerTotalActual() {

            let total = 0;


            document.querySelectorAll(
                "#detalleBody tr"
            ).forEach(row => {


                const cantidad =
                    parseFloat(
                        row.querySelector(
                            ".det-cantidad"
                        ).value
                    ) || 0;


                const precio =
                    parseFloat(
                        row.querySelector(
                            ".det-precio"
                        ).value
                    ) || 0;


                total +=
                    cantidad *
                    precio;

            });


            return total;

        }



        // =========================================================
        // VUELTO
        // =========================================================

        function calcularVuelto() {

            const total =
                parseFloat(
                    document.getElementById(
                        "txtTotal"
                    ).value
                ) || 0;


            const pagoC =
                parseFloat(
                    document.getElementById(
                        "txtPagoC"
                    ).value
                ) || 0;


            const pagoD =
                parseFloat(
                    document.getElementById(
                        "txtPagoD"
                    ).value
                ) || 0;


            const pagado =
                pagoC +
                (
                    pagoD *
                    tasaCambio
                );


            const vuelto =
                pagado -
                total;


            const inputVuelto =
                document.getElementById(
                    "txtVuelto"
                );


            const vueltoVisual =
                document.getElementById(
                    "lblVueltoVisual"
                );


            const mensaje =
                document.getElementById(
                    "txtMensajeVuelto"
                );


            const box =
                document.getElementById(
                    "changeBox"
                );


            const boton =
                document.getElementById(
                    "btnGuardarFactura"
                );


            inputVuelto.value =
                vuelto.toFixed(2);


            vueltoVisual.innerText =
                "C$ " +
                vuelto.toFixed(2);


            if (vuelto < 0) {

                box.className =
                    "change-box insufficient";


                mensaje.innerText =
                    "Pago insuficiente";


                boton.disabled =
                    true;

            }
            else {

                box.className =
                    "change-box valid";


                mensaje.innerText =
                    vuelto > 0
                        ? "Debe entregar vuelto"
                        : "Pago exacto";


                boton.disabled =
                    false;

            }

        }



        // =========================================================
        // GUARDAR
        // =========================================================

        function guardarFactura() {

            const paciente =
                document.getElementById(
                    "txtPaciente"
                ).value;


            if (!paciente.trim()) {

                Swal.fire(
                    "Información requerida",
                    "Debe registrar el nombre del paciente.",
                    "warning"
                );

                return;
            }


            const detalle = [];


            document.querySelectorAll(
                "#detalleBody tr"
            ).forEach(tr => {


                detalle.push({

                    IdProducto:
                        parseInt(
                            tr.dataset.id
                        ),

                    NombreProducto:
                        tr
                            .querySelector(
                                ".col-nombre strong"
                            )
                            .innerText
                            .trim(),

                    CodBarra:
                        tr
                            .querySelector(
                                ".col-codbarra"
                            )
                            .innerText
                            .trim(),

                    Cantidad:
                        parseFloat(
                            tr.querySelector(
                                ".det-cantidad"
                            ).value
                        ) || 0,

                    Precio:
                        parseFloat(
                            tr.querySelector(
                                ".det-precio"
                            ).value
                        ) || 0

                });

            });


            if (detalle.length === 0) {

                Swal.fire(
                    "Atención",
                    "Debe agregar productos.",
                    "warning"
                );

                return;

            }


            document.getElementById(
                "hdPaciente"
            ).value =
                paciente;


            document.getElementById(
                "hdPagoCordoba"
            ).value =
                document.getElementById(
                    "txtPagoC"
                ).value || 0;


            document.getElementById(
                "hdPagoDolar"
            ).value =
                document.getElementById(
                    "txtPagoD"
                ).value || 0;


            document.getElementById(
                "hdVuelto"
            ).value =
                document.getElementById(
                    "txtVuelto"
                ).value || 0;


            document.getElementById(
                "hdDetalleJson"
            ).value =
                JSON.stringify(
                    detalle
                );


            const boton =
                document.getElementById(
                    "btnGuardarFactura"
                );


            boton.disabled = true;

            boton.innerHTML = `

                <span class="spinner-border spinner-border-sm"></span>

                Procesando...
            `;


            document.getElementById(
                "formFactura"
            ).submit();

        }



        // =========================================================
        // F2
        // =========================================================

        document.addEventListener(
            "keydown",
            function (e) {

                if (e.key === "F2") {

                    e.preventDefault();

                    abrirBuscador();

                }

            }
        );



        // =========================================================
        // SWEET ALERT
        // =========================================================

        @if (TempData["Ok"] != null)
        {
                <text>

                        Swal.fire({

                            icon: "success",

                            title: "Venta registrada",

                            text: "@TempData["Ok"]",

                            timer: 2000,

                            showConfirmButton: false

                        });

                </text>
        }


        @if (TempData["Error"] != null)
        {
                <text>

                        Swal.fire({

                            icon: "error",

                            title: "Error",

                            text: "@TempData["Error"]"

                        });

                </text>
        }


        recalcularTotal();

    </script>

}