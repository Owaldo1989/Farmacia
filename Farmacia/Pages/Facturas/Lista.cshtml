@page
@model Farmacia.Pages.Facturas.ListaModel

@{
    ViewData["Title"] = "Facturas";

    var totalFacturas =
        Model.Listado?.Count ?? 0;

    var totalFacturado =
        Model.Listado?.Sum(x => x.Total) ?? 0;

    var totalPagoCordoba =
        Model.Listado?.Sum(x => x.PagoCordoba) ?? 0;

    var totalPagoDolar =
        Model.Listado?.Sum(x => x.PagoDolar) ?? 0;
}


<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />

<link rel="stylesheet"
      href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.bootstrap5.min.css" />

<link rel="stylesheet"
      href="~/css/facturas-lista.css"
      asp-append-version="true" />


<div class="invoices-page">


    <!-- =====================================================
         ENCABEZADO
    ====================================================== -->

    <section class="invoices-header">

        <div>

            <div class="invoices-eyebrow">

                <i class="bi bi-receipt"></i>

                Facturación

            </div>


            <h1>
                Facturas realizadas
            </h1>


            <p>
                Consulta las ventas realizadas,
                revisa su detalle y reimprime comprobantes.
            </p>

        </div>


        <a asp-page="/Facturas/Nueva"
           class="btn-new-invoice">

            <i class="bi bi-plus-lg"></i>

            Nueva venta

        </a>

    </section>



    <!-- =====================================================
         INDICADORES
    ====================================================== -->

    <section class="invoice-stats">


        <!-- CANTIDAD -->

        <div class="invoice-stat">


            <div class="invoice-stat-icon primary">

                <i class="bi bi-receipt"></i>

            </div>


            <div>

                <span>
                    Facturas
                </span>

                <strong>
                    @totalFacturas
                </strong>

                <small>
                    En el período seleccionado
                </small>

            </div>


        </div>



        <!-- TOTAL -->

        <div class="invoice-stat">


            <div class="invoice-stat-icon success">

                <i class="bi bi-cash-stack"></i>

            </div>


            <div>

                <span>
                    Total facturado
                </span>

                <strong>
                    C$ @totalFacturado.ToString("N2")
                </strong>

                <small>
                    Ventas del período
                </small>

            </div>


        </div>



        <!-- CÓRDOBAS -->

        <div class="invoice-stat">


            <div class="invoice-stat-icon money">

                <span>
                    C$
                </span>

            </div>


            <div>

                <span>
                    Recibido en córdobas
                </span>

                <strong>
                    C$ @totalPagoCordoba.ToString("N2")
                </strong>

                <small>
                    Forma de pago
                </small>

            </div>


        </div>



        <!-- DÓLARES -->

        <div class="invoice-stat">


            <div class="invoice-stat-icon dollar">

                <i class="bi bi-currency-dollar"></i>

            </div>


            <div>

                <span>
                    Recibido en dólares
                </span>

                <strong>
                    US$ @totalPagoDolar.ToString("N2")
                </strong>

                <small>
                    Forma de pago
                </small>

            </div>


        </div>


    </section>



    <!-- =====================================================
         FILTROS
    ====================================================== -->

    <section class="invoice-filters">


        <div class="invoice-filter-header">


            <div>

                <h2>
                    Filtrar facturas
                </h2>

                <p>
                    Selecciona el período que deseas consultar.
                </p>

            </div>


            <i class="bi bi-funnel"></i>


        </div>


        <form method="get"
              id="formFiltros"
              class="invoice-filter-form">


            <!-- FECHA INICIO -->

            <div class="invoice-field">

                <label asp-for="FechaInicio">
                    Desde
                </label>


                <div class="invoice-input">

                    <i class="bi bi-calendar3"></i>

                    <input type="date"
                           asp-for="FechaInicio" />

                </div>

            </div>



            <!-- FECHA FIN -->

            <div class="invoice-field">

                <label asp-for="FechaFin">
                    Hasta
                </label>


                <div class="invoice-input">

                    <i class="bi bi-calendar3"></i>

                    <input type="date"
                           asp-for="FechaFin" />

                </div>

            </div>



            <!-- PACIENTE -->

            <div class="invoice-field invoice-patient-field">

                <label>
                    Paciente
                </label>


                <div class="invoice-input">

                    <i class="bi bi-person"></i>

                    <input type="text"
                           id="filtroPaciente"
                           placeholder="Buscar paciente..."
                           autocomplete="off" />

                    <button type="button"
                            id="btnLimpiarPaciente"
                            class="btn-clear-patient"
                            style="display:none;">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>

            </div>



            <!-- BOTÓN -->

            <div class="invoice-filter-action">

                <button type="submit"
                        class="btn-filter-invoices">

                    <i class="bi bi-search"></i>

                    Consultar

                </button>

            </div>


        </form>


    </section>



    <!-- =====================================================
         TABLA
    ====================================================== -->

    <section class="invoices-card">


        <div class="invoices-card-header">


            <div>

                <h2>
                    Historial de facturas
                </h2>

                <p>
                    Facturas encontradas para el período seleccionado.
                </p>

            </div>


            <div class="invoice-period">

                <i class="bi bi-calendar-range"></i>

                <span>

                    @Model.FechaInicio.ToString("dd/MM/yyyy")

                    -

                    @Model.FechaFin.ToString("dd/MM/yyyy")

                </span>

            </div>


        </div>



        @if (Model.Listado != null &&
             Model.Listado.Any())
        {

            <div class="invoice-table-container">


                <table id="tablaFacturas"
                       class="invoice-table">


                    <thead>

                        <tr>

                            <th>
                                Factura
                            </th>

                            <th>
                                Fecha
                            </th>

                            <th>
                                Paciente
                            </th>

                            <th class="text-end">
                                Total
                            </th>

                            <th class="text-end">
                                Pago C$
                            </th>

                            <th class="text-end">
                                Pago US$
                            </th>

                            <th class="text-end">
                                Vuelto
                            </th>

                            <th class="invoice-actions-column">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                        @foreach (var factura in Model.Listado)
                        {

                            <tr>


                                <!-- FACTURA -->

                                <td>

                                    <div class="invoice-number">

                                        <div class="invoice-number-icon">

                                            <i class="bi bi-receipt"></i>

                                        </div>


                                        <div>

                                            <strong>

                                                #@factura.IdFactura

                                            </strong>

                                            <span>
                                                Factura
                                            </span>

                                        </div>

                                    </div>

                                </td>



                                <!-- FECHA -->

                                <td>

                                    <div class="invoice-date">

                                        <strong>

                                            @factura.Fecha.ToString("dd/MM/yyyy")

                                        </strong>

                                        <span>

                                            @factura.Fecha.ToString("hh:mm tt")

                                        </span>

                                    </div>

                                </td>



                                <!-- PACIENTE -->

                                <td>

                                    <div class="invoice-patient">

                                        <div class="patient-avatar">

                                            <i class="bi bi-person"></i>

                                        </div>


                                        <span>

                                            @(string.IsNullOrWhiteSpace(
                                                factura.Paciente)
                                                ? "Consumidor final"
                                                : factura.Paciente)

                                        </span>

                                    </div>

                                </td>



                                <!-- TOTAL -->

                                <td class="text-end">

                                    <strong class="invoice-total">

                                        C$
                                        @factura.Total.ToString("N2")

                                    </strong>

                                </td>



                                <!-- CÓRDOBAS -->

                                <td class="text-end">

                                    <span class="invoice-money">

                                        C$
                                        @factura.PagoCordoba.ToString("N2")

                                    </span>

                                </td>



                                <!-- DÓLARES -->

                                <td class="text-end">

                                    @if (factura.PagoDolar > 0)
                                    {

                                        <span class="invoice-dollar">

                                            US$
                                            @factura.PagoDolar.ToString("N2")

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="invoice-zero">

                                            US$ 0.00

                                        </span>

                                    }

                                </td>



                                <!-- VUELTO -->

                                <td class="text-end">

                                    <span class="invoice-change">

                                        C$
                                        @factura.Vuelto.ToString("N2")

                                    </span>

                                </td>



                                <!-- ACCIONES -->

                                <td>

                                    <div class="invoice-actions">


                                        <!-- VER -->

                                        <button type="button"
                                                class="invoice-action view"
                                                title="Ver detalle"
                                                onclick="verDetalle(@factura.IdFactura)">

                                            <i class="bi bi-eye"></i>

                                        </button>



                                        <!-- IMPRIMIR -->

                                        <button type="button"
                                                class="invoice-action print"
                                                title="Reimprimir"
                                                onclick="reimprimir(@factura.IdFactura)">

                                            <i class="bi bi-printer"></i>

                                        </button>



                                        <!-- ANULAR -->

                                        <button type="button"
                                                class="invoice-action cancel"
                                                title="Anular factura"
                                                onclick="anularFactura(@factura.IdFactura)">

                                            <i class="bi bi-x-circle"></i>

                                        </button>


                                    </div>

                                </td>


                            </tr>

                        }


                    </tbody>


                </table>


            </div>

        }
        else
        {

            <div class="invoice-empty">


                <div class="invoice-empty-icon">

                    <i class="bi bi-receipt"></i>

                </div>


                <strong>
                    No hay facturas
                </strong>


                <span>
                    No encontramos ventas realizadas
                    en el período seleccionado.
                </span>


                <a asp-page="/Facturas/Nueva">

                    <i class="bi bi-plus-lg"></i>

                    Nueva venta

                </a>


            </div>

        }


    </section>


</div>



<!-- =========================================================
     MODAL DETALLE
========================================================== -->

<div class="modal fade"
     id="modalDetalle"
     tabindex="-1"
     aria-hidden="true">


    <div class="modal-dialog
        modal-xl
        modal-dialog-centered
        modal-dialog-scrollable">


        <div class="modal-content invoice-detail-modal">


            <!-- HEADER -->

            <div class="modal-header invoice-detail-header">


                <div class="invoice-detail-title">


                    <div class="invoice-detail-icon">

                        <i class="bi bi-receipt"></i>

                    </div>


                    <div>

                        <h5>
                            Detalle de factura
                        </h5>

                        <span id="detFacturaSubtitulo">
                            Información de la venta realizada.
                        </span>

                    </div>


                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>


            </div>



            <!-- BODY -->

            <div class="modal-body invoice-detail-body">


                <!-- INFORMACIÓN ENCABEZADO -->

                <div class="invoice-detail-summary">


                    <div class="detail-summary-item">


                        <div class="detail-summary-icon">

                            <i class="bi bi-calendar3"></i>

                        </div>


                        <div>

                            <span>
                                Fecha
                            </span>

                            <strong id="detFecha">
                                -
                            </strong>

                        </div>


                    </div>



                    <div class="detail-summary-item">


                        <div class="detail-summary-icon">

                            <i class="bi bi-person"></i>

                        </div>


                        <div>

                            <span>
                                Paciente
                            </span>

                            <strong id="detPaciente">
                                -
                            </strong>

                        </div>


                    </div>



                    <div class="detail-summary-item total">


                        <div class="detail-summary-icon">

                            <i class="bi bi-cash-stack"></i>

                        </div>


                        <div>

                            <span>
                                Total
                            </span>

                            <strong id="detTotal">
                                C$ 0.00
                            </strong>

                        </div>


                    </div>


                </div>



                <!-- PRODUCTOS -->

                <div class="invoice-products-section">


                    <div class="invoice-products-header">


                        <div>

                            <h3>
                                Productos
                            </h3>

                            <p>
                                Detalle de artículos facturados.
                            </p>

                        </div>


                        <div class="invoice-products-icon">

                            <i class="bi bi-capsule-pill"></i>

                        </div>


                    </div>



                    <div class="invoice-detail-table-wrapper">


                        <table class="invoice-detail-table">


                            <thead>

                                <tr>

                                    <th>
                                        Producto
                                    </th>

                                    <th>
                                        Código
                                    </th>

                                    <th class="text-end">
                                        Cantidad
                                    </th>

                                    <th class="text-end">
                                        Precio
                                    </th>

                                    <th class="text-end">
                                        Subtotal
                                    </th>

                                </tr>

                            </thead>


                            <tbody id="detalleTabla">
                            </tbody>


                        </table>


                    </div>


                </div>



                <!-- PAGOS -->

                <div class="invoice-payment-summary">


                    <div class="payment-summary-title">

                        <i class="bi bi-wallet2"></i>

                        <span>
                            Resumen del pago
                        </span>

                    </div>


                    <div class="payment-summary-values">


                        <div>

                            <span>
                                Pago en córdobas
                            </span>

                            <strong id="detPagoC">
                                C$ 0.00
                            </strong>

                        </div>


                        <div>

                            <span>
                                Pago en dólares
                            </span>

                            <strong id="detPagoD">
                                US$ 0.00
                            </strong>

                        </div>


                        <div class="change">

                            <span>
                                Vuelto
                            </span>

                            <strong id="detVuelto">
                                C$ 0.00
                            </strong>

                        </div>


                    </div>


                </div>


            </div>



            <!-- FOOTER -->

            <div class="modal-footer invoice-detail-footer">


                <button type="button"
                        class="btn-detail-close"
                        data-bs-dismiss="modal">

                    Cerrar

                </button>


                <button type="button"
                        class="btn-detail-print"
                        id="btnReprint">

                    <i class="bi bi-printer"></i>

                    Reimprimir ticket

                </button>


            </div>


        </div>


    </div>


</div>



@section Scripts {


    <!-- =====================================================
         DATATABLES 1.13
    ====================================================== -->

    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.bootstrap5.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>



    <script>


        // =====================================================
        // DATATABLE
        // =====================================================

        let tablaFacturas = null;


        document.addEventListener(
        "DOMContentLoaded",
        function () {


        if (
        document.getElementById(
        "tablaFacturas"
        )
        ) {

        tablaFacturas =
        $("#tablaFacturas")
        .DataTable({

        pageLength: 10,

        lengthMenu: [
        [10, 25, 50, 100, -1],
        [10, 25, 50, 100, "Todos"]
        ],

        order: [],

        dom:
        '<"invoice-dt-toolbar"<"invoice-export"B><"invoice-length"l>>' +
        'rt' +
        '<"invoice-dt-footer"<"invoice-info"i><"invoice-pagination"p>>',

        buttons: [

        {
        extend:
        "excelHtml5",

        text:
        '<i class="bi bi-file-earmark-excel"></i> Excel',

        className:
        "btn-export"
        },

        {
        extend:
        "pdfHtml5",

        text:
        '<i class="bi bi-file-earmark-pdf"></i> PDF',

        className:
        "btn-export"
        },

        {
        extend:
        "print",

        text:
        '<i class="bi bi-printer"></i> Imprimir',

        className:
        "btn-export"
        }

        ],

        language: {

        emptyTable:
        "No hay facturas disponibles",

        info:
        "Mostrando _START_ a _END_ de _TOTAL_ facturas",

        infoEmpty:
        "Sin registros",

        lengthMenu:
        "Mostrar _MENU_",

        zeroRecords:
        "No se encontraron facturas",

        paginate: {

        first:
        "Primero",

        last:
        "Último",

        next:
        "Siguiente",

        previous:
        "Anterior"

        }

        }

        });

        }


        }
        );



        // =====================================================
        // FILTRO PACIENTE
        // =====================================================

        const filtroPaciente =
        document.getElementById(
        "filtroPaciente"
        );


        const btnLimpiarPaciente =
        document.getElementById(
        "btnLimpiarPaciente"
        );


        filtroPaciente?.addEventListener(
        "input",
        function () {


        if (tablaFacturas) {

        tablaFacturas
        .column(2)
        .search(
        this.value
        )
        .draw();

        }


        btnLimpiarPaciente.style.display =
        this.value
        ? "flex"
        : "none";

        }
        );



        btnLimpiarPaciente?.addEventListener(
        "click",
        function () {


        filtroPaciente.value = "";


        if (tablaFacturas) {

        tablaFacturas
        .column(2)
        .search("")
        .draw();

        }


        this.style.display =
        "none";


        filtroPaciente.focus();

        }
        );



        // =====================================================
        // REIMPRIMIR
        // =====================================================

        function reimprimir(id) {

        window.open(
        `/Facturas/VerTicket/${id}`,
        "_blank"
        );

        }



        // =====================================================
        // ANULAR
        // =====================================================

        function anularFactura(id) {


        Swal.fire({

        title:
        "¿Anular factura?",

        text:
        "Esta operación requiere confirmación.",

        icon:
        "warning",

        showCancelButton:
        true,

        confirmButtonText:
        "Sí, anular",

        cancelButtonText:
        "Cancelar",

        confirmButtonColor:
        "#d6535d"

        })
        .then(resultado => {

        if (resultado.isConfirmed) {

        window.location.href =
        `/Facturas/Lista?handler=Anular&id=${id}`;

        }

        });

        }



        // =====================================================
        // DETALLE
        // =====================================================

        async function verDetalle(id) {


        try {


        const respuesta =
        await fetch(
        `/Facturas/Lista?handler=Detalle&id=${id}`
        );


        if (!respuesta.ok) {

        throw new Error(
        "No fue posible obtener el detalle."
        );

        }


        const data =
        await respuesta.json();



        // =============================================
        // ENCABEZADO
        // =============================================

        document.getElementById(
        "detFacturaSubtitulo"
        ).textContent =
        `Factura #${id}`;


        document.getElementById(
        "detFecha"
        ).textContent =
        data.fecha || "-";


        document.getElementById(
        "detPaciente"
        ).textContent =
        data.paciente ||
        "Consumidor final";


        document.getElementById(
        "detTotal"
        ).textContent =
        "C$ " +
        data.total;



        document.getElementById(
        "detPagoC"
        ).textContent =
        "C$ " +
        data.pagoCordoba;


        document.getElementById(
        "detPagoD"
        ).textContent =
        "US$ " +
        data.pagoDolar;


        document.getElementById(
        "detVuelto"
        ).textContent =
        "C$ " +
        data.vuelto;



        // =============================================
        // DETALLE PRODUCTOS
        // =============================================

        const cuerpo =
        document.getElementById(
        "detalleTabla"
        );


        cuerpo.innerHTML = "";


        data.detalles.forEach(
        detalle => {


        const fila =
        document.createElement(
        "tr"
        );


        agregarCelda(
        fila,
        detalle.nombreProducto
        );


        agregarCelda(
        fila,
        detalle.codBarra || "-"
        );


        agregarCelda(
        fila,
        detalle.cantidad,
        "text-end"
        );


        agregarCelda(
        fila,
        "C$ " + detalle.precio,
        "text-end"
        );


        agregarCelda(
        fila,
        "C$ " + detalle.subTotal,
        "text-end detail-subtotal"
        );


        cuerpo.appendChild(
        fila
        );


        }
        );



        // =============================================
        // REIMPRIMIR DESDE MODAL
        // =============================================

        document.getElementById(
        "btnReprint"
        ).onclick =
        function () {

        reimprimir(id);

        };



        new bootstrap.Modal(
        document.getElementById(
        "modalDetalle"
        )
        ).show();


        }
        catch (error) {


        Swal.fire({

        icon:
        "error",

        title:
        "No se pudo cargar",

        text:
        error.message

        });


        }


        }



        // =====================================================
        // CREAR CELDA SEGURA
        // =====================================================

        function agregarCelda(
        fila,
        texto,
        clase = ""
        ) {


        const celda =
        document.createElement(
        "td"
        );


        celda.textContent =
        texto ?? "";


        if (clase) {

        clase
        .split(" ")
        .forEach(
        c =>
        celda.classList.add(c)
        );

        }


        fila.appendChild(
        celda
        );


        }


    </script>

}