@page
@model Farmacia.Pages.Laboratorios.LaboratoriosModel

<h3 class="fw-bold mb-3">
    <i class="bi bi-building"></i> Laboratorios
</h3>

<a class="btn btn-primary mb-3" asp-page="Guardar">Nuevo Laboratorio</a>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Laboratorio</th>
            <th style="width:150px">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var l in Model.Lista)
        {
            <tr>
                <td>@l.IdLaboratorio</td>
                <td>@l.LaboratorioNombre</td>
                <td>
                    <a asp-page="Guardar" asp-route-id="@l.IdLaboratorio" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-page="Eliminar" asp-route-id="@l.IdLaboratorio" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
