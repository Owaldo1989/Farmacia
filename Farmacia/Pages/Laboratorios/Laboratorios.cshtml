@page "/Laboratorio/Laboratorio"
@model Farmacia.Pages.Laboratorios.LaboratoriosModel

@{
    ViewData["Title"] = "Laboratorios";

    var totalLaboratorios =
        Model.Listado?.Count ?? 0;
}

<link rel="stylesheet"
      href="~/css/laboratorios.css"
      asp-append-version="true" />


<div class="labs-page">


    <!-- =====================================================
         ENCABEZADO
    ====================================================== -->

    <section class="labs-header">

        <div class="labs-header-info">

            <div class="labs-eyebrow">

                <i class="bi bi-building"></i>

                Catálogo

            </div>


            <h1>
                Laboratorios
            </h1>


            <p>
                Administra los laboratorios y fabricantes
                asociados a los productos de la farmacia.
            </p>

        </div>


        <button type="button"
                class="btn-new-lab"
                onclick="nuevoLaboratorio()">

            <i class="bi bi-plus-lg"></i>

            <span>
                Nuevo laboratorio
            </span>

        </button>

    </section>



    <!-- =====================================================
         RESUMEN
    ====================================================== -->

    <section class="labs-summary">

        <div class="labs-summary-icon">

            <i class="bi bi-buildings"></i>

        </div>


        <div class="labs-summary-info">

            <span>
                Laboratorios registrados
            </span>

            <strong>
                @totalLaboratorios
            </strong>

        </div>


        <div class="labs-summary-description">

            <i class="bi bi-info-circle"></i>

            <span>
                Estos laboratorios pueden ser utilizados
                para clasificar los medicamentos y productos.
            </span>

        </div>

    </section>



    <!-- =====================================================
         BUSCADOR
    ====================================================== -->

    <section class="labs-toolbar">


        <div class="labs-search">

            <i class="bi bi-search"></i>


            <input type="text"
                   id="txtBuscarLaboratorio"
                   placeholder="Buscar laboratorio..."
                   autocomplete="off" />


            <button type="button"
                    id="btnLimpiarBusqueda"
                    class="btn-clear-lab-search"
                    title="Limpiar búsqueda"
                    style="display:none;">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>


        <div class="labs-results">

            <span id="contadorLaboratorios">
                @totalLaboratorios
            </span>

            <span>
                resultados
            </span>

        </div>


    </section>



    <!-- =====================================================
         LISTADO
    ====================================================== -->

    <section class="labs-card">


        <div class="labs-card-header">


            <div>

                <h2>
                    Listado de laboratorios
                </h2>

                <p>
                    Catálogo disponible para los productos.
                </p>

            </div>


            <div class="labs-card-icon">

                <i class="bi bi-list-ul"></i>

            </div>


        </div>



        @if (Model.Listado != null &&
             Model.Listado.Any())
        {

            <div class="labs-table-wrapper">

                <table class="labs-table">

                    <thead>

                        <tr>

                            <th class="lab-id-column">
                                Código
                            </th>

                            <th>
                                Laboratorio
                            </th>

                            <th class="lab-actions-column">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody id="laboratoriosBody">

                        @foreach (var laboratorio in Model.Listado)
                        {

                            <tr class="lab-row"
                                data-laboratorio="@laboratorio.LaboratorioNombre?.ToLower()">


                                <!-- ID -->

                                <td>

                                    <span class="lab-id">

                                        #@laboratorio.IdLaboratorio

                                    </span>

                                </td>



                                <!-- LABORATORIO -->

                                <td>

                                    <div class="lab-information">


                                        <div class="lab-avatar">

                                            <i class="bi bi-building"></i>

                                        </div>


                                        <div class="lab-name">

                                            <strong>
                                                @laboratorio.LaboratorioNombre
                                            </strong>

                                            <span>
                                                Laboratorio / fabricante
                                            </span>

                                        </div>


                                    </div>

                                </td>



                                <!-- ACCIONES -->

                                <td>

                                    <div class="lab-actions">


                                        <button type="button"
                                                class="lab-action edit"
                                                title="Editar laboratorio"
                                                onclick="editarLaboratorio(@laboratorio.IdLaboratorio)">

                                            <i class="bi bi-pencil"></i>

                                            <span>
                                                Editar
                                            </span>

                                        </button>


                                        <button type="button"
                                                class="lab-action delete"
                                                title="Eliminar laboratorio"
                                                onclick="eliminarLaboratorio(@laboratorio.IdLaboratorio)">

                                            <i class="bi bi-trash3"></i>

                                        </button>


                                    </div>

                                </td>


                            </tr>

                        }

                    </tbody>

                </table>

            </div>


            <!-- SIN RESULTADOS DE BÚSQUEDA -->

            <div class="labs-no-results"
                 id="sinResultadosBusqueda"
                 style="display:none;">


                <div class="labs-empty-icon">

                    <i class="bi bi-search"></i>

                </div>


                <strong>
                    No encontramos laboratorios
                </strong>


                <span>
                    Intenta escribir otro nombre.
                </span>


                <button type="button"
                        onclick="limpiarBusqueda()">

                    Limpiar búsqueda

                </button>


            </div>

        }
        else
        {

            <div class="labs-empty">


                <div class="labs-empty-icon">

                    <i class="bi bi-building-add"></i>

                </div>


                <strong>
                    No hay laboratorios registrados
                </strong>


                <span>
                    Agrega el primer laboratorio para
                    comenzar a utilizar este catálogo.
                </span>


                <button type="button"
                        onclick="nuevoLaboratorio()">

                    <i class="bi bi-plus-lg"></i>

                    Nuevo laboratorio

                </button>


            </div>

        }


    </section>


</div>



<!-- =========================================================
     MODAL LABORATORIO
========================================================== -->

<div class="modal fade"
     id="modalLaboratorio"
     tabindex="-1"
     aria-labelledby="modalLaboratorioTitulo"
     aria-hidden="true">


    <div class="modal-dialog modal-dialog-centered">


        <div class="modal-content lab-modal">


            <form method="post"
                  id="formLaboratorio">


                <!-- HEADER -->

                <div class="modal-header lab-modal-header">


                    <div class="lab-modal-title">


                        <div class="lab-modal-title-icon">

                            <i class="bi bi-building"></i>

                        </div>


                        <div>

                            <h5 id="modalLaboratorioTitulo">
                                Nuevo laboratorio
                            </h5>

                            <span id="modalLaboratorioSubtitulo">
                                Registra un nuevo laboratorio.
                            </span>

                        </div>


                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>


                </div>



                <!-- BODY -->

                <div class="modal-body lab-modal-body">


                    <input type="hidden"
                           asp-for="Laboratorio.IdLaboratorio" />


                    <div class="lab-field">


                        <label asp-for="Laboratorio.LaboratorioNombre">

                            Nombre del laboratorio

                            <span>*</span>

                        </label>


                        <div class="lab-input">

                            <i class="bi bi-building"></i>


                            <input asp-for="Laboratorio.LaboratorioNombre"
                                   maxlength="150"
                                   autocomplete="off"
                                   placeholder="Ej. Bayer, Pfizer, MK..."
                                   required />

                        </div>


                        <span asp-validation-for="Laboratorio.LaboratorioNombre"
                              class="lab-validation">
                        </span>


                        <small>

                            Escribe el nombre comercial o razón
                            con la que identificarás al laboratorio.

                        </small>


                    </div>


                </div>



                <!-- FOOTER -->

                <div class="modal-footer lab-modal-footer">


                    <button type="button"
                            class="btn-lab-cancel"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>


                    <button type="submit"
                            class="btn-lab-save"
                            id="btnGuardarLaboratorio">

                        <i class="bi bi-check-lg"></i>

                        <span id="textoGuardarLaboratorio">
                            Guardar laboratorio
                        </span>

                    </button>


                </div>


            </form>


        </div>


    </div>

</div>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        // =====================================================
        // NUEVO LABORATORIO
        // =====================================================

        function nuevoLaboratorio() {

            document.getElementById(
                "Laboratorio_IdLaboratorio"
            ).value = 0;


            document.getElementById(
                "Laboratorio_LaboratorioNombre"
            ).value = "";


            document.getElementById(
                "modalLaboratorioTitulo"
            ).textContent =
                "Nuevo laboratorio";


            document.getElementById(
                "modalLaboratorioSubtitulo"
            ).textContent =
                "Registra un nuevo laboratorio.";


            document.getElementById(
                "textoGuardarLaboratorio"
            ).textContent =
                "Guardar laboratorio";


            const modal =
                new bootstrap.Modal(
                    document.getElementById(
                        "modalLaboratorio"
                    )
                );


            modal.show();


            document
                .getElementById(
                    "modalLaboratorio"
                )
                .addEventListener(
                    "shown.bs.modal",
                    function () {

                        document.getElementById(
                            "Laboratorio_LaboratorioNombre"
                        ).focus();

                    },
                    { once: true }
                );

        }



        // =====================================================
        // EDITAR
        // =====================================================

        function editarLaboratorio(id) {

            window.location.href =
                "/Laboratorio/Laboratorio?id=" + id;

        }



        // =====================================================
        // ELIMINAR
        // =====================================================

        function eliminarLaboratorio(id) {

            Swal.fire({

                title:
                    "¿Eliminar laboratorio?",

                text:
                    "Esta acción no se puede deshacer.",

                icon:
                    "warning",

                showCancelButton:
                    true,

                confirmButtonText:
                    "Sí, eliminar",

                cancelButtonText:
                    "Cancelar",

                confirmButtonColor:
                    "#d6535d"

            })
            .then((resultado) => {

                if (resultado.isConfirmed) {

                    window.location.href =
                        "/Laboratorio/Laboratorio?eliminar=" +
                        id;

                }

            });

        }



        // =====================================================
        // FILTRO INSTANTÁNEO
        // =====================================================

        const inputBuscar =
            document.getElementById(
                "txtBuscarLaboratorio"
            );


        const botonLimpiar =
            document.getElementById(
                "btnLimpiarBusqueda"
            );


        inputBuscar?.addEventListener(
            "input",
            function () {

                filtrarLaboratorios();

            }
        );



        function filtrarLaboratorios() {

            const filtro =
                inputBuscar.value
                    .trim()
                    .toLowerCase();


            const filas =
                document.querySelectorAll(
                    ".lab-row"
                );


            let visibles = 0;


            filas.forEach(fila => {

                const nombre =
                    fila.dataset.laboratorio || "";


                const mostrar =
                    nombre.includes(filtro);


                fila.style.display =
                    mostrar
                        ? ""
                        : "none";


                if (mostrar) {
                    visibles++;
                }

            });


            document.getElementById(
                "contadorLaboratorios"
            ).textContent =
                visibles;


            botonLimpiar.style.display =
                filtro
                    ? "flex"
                    : "none";


            const sinResultados =
                document.getElementById(
                    "sinResultadosBusqueda"
                );


            if (sinResultados) {

                sinResultados.style.display =
                    visibles === 0
                        ? "flex"
                        : "none";

            }

        }



        function limpiarBusqueda() {

            inputBuscar.value = "";

            filtrarLaboratorios();

            inputBuscar.focus();

        }



        botonLimpiar?.addEventListener(
            "click",
            limpiarBusqueda
        );



        // =====================================================
        // BLOQUEAR DOBLE GUARDADO
        // =====================================================

        document
            .getElementById(
                "formLaboratorio"
            )
            ?.addEventListener(
                "submit",
                function () {

                    const boton =
                        document.getElementById(
                            "btnGuardarLaboratorio"
                        );


                    boton.disabled = true;


                    boton.innerHTML = `

                        <span class="spinner-border spinner-border-sm"></span>

                        Guardando...
                    `;

                }
            );



        // =====================================================
        // CARGA INICIAL
        // =====================================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                // =============================================
                // MENSAJE OK
                // =============================================

                @if (TempData["Ok"] != null)
                {
                        <text>

                            Swal.fire({

                                icon:
                                    "success",

                                title:
                                    "Completado",

                                text:
                                    @Html.Raw(
                                            System.Text.Json.JsonSerializer.Serialize(
                                                    TempData["Ok"]
                                            )
                                    ),

                                timer:
                                    1800,

                                showConfirmButton:
                                    false

                            });

                        </text>
                }



                // =============================================
                // ERROR
                // =============================================

                @if (TempData["Error"] != null)
                {
                        <text>

                            Swal.fire({

                                icon:
                                    "error",

                                title:
                                    "No se pudo completar",

                                text:
                                    @Html.Raw(
                                            System.Text.Json.JsonSerializer.Serialize(
                                                    TempData["Error"]
                                            )
                                    )

                            });

                        </text>
                }



                // =============================================
                // MODO EDICIÓN
                // =============================================

                @if (TempData["Editar"] != null)
                {
                        <text>

                            const esEdicion =
                                @Model.Laboratorio.IdLaboratorio > 0;


                            document.getElementById(
                                "modalLaboratorioTitulo"
                            ).textContent =
                                esEdicion
                                    ? "Editar laboratorio"
                                    : "Nuevo laboratorio";


                            document.getElementById(
                                "modalLaboratorioSubtitulo"
                            ).textContent =
                                esEdicion
                                    ? "Actualiza la información del laboratorio."
                                    : "Revisa la información e intenta guardarla nuevamente.";


                            document.getElementById(
                                "textoGuardarLaboratorio"
                            ).textContent =
                                esEdicion
                                    ? "Guardar cambios"
                                    : "Guardar laboratorio";


                            new bootstrap.Modal(
                                document.getElementById(
                                    "modalLaboratorio"
                                )
                            ).show();

                        </text>
                }


            }
        );

    </script>

}