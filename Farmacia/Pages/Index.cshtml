@page
@model Farmacia.Pages.IndexModel

@{
    ViewData["Title"] = "Inicio";

    var nombre = HttpContext.Session.GetString("Nombre");
    var rol = HttpContext.Session.GetString("Rol");
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<div class="dashboard-page">

    <!-- =====================================================
         ENCABEZADO
    ====================================================== -->

    <section class="dashboard-header">

        <div>

            <div class="dashboard-eyebrow">
                <i class="bi bi-capsule-pill"></i>
                Sistema Farmacia
            </div>

            <h1>
                Hola, @nombre
            </h1>

            <p>
                Este es el resumen general de tu farmacia.
            </p>

        </div>


        <div class="dashboard-user">

            <div class="user-avatar">
                <i class="bi bi-person"></i>
            </div>

            <div class="user-info">
                <strong>@nombre</strong>
                <span>@rol</span>
            </div>

        </div>

    </section>


    <!-- =====================================================
         VENTAS
    ====================================================== -->

    <div class="section-heading">

        <div>
            <h2>Resumen de ventas</h2>
            <p>Comportamiento de las ventas registradas.</p>
        </div>

        <div class="section-icon">
            <i class="bi bi-graph-up-arrow"></i>
        </div>

    </div>


    <section class="sales-grid">


        <!-- VENTA DÍA -->

        <article class="stat-card">

            <div class="stat-header">

                <div class="stat-icon green">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <span class="stat-badge">
                    Hoy
                </span>

            </div>


            <div class="stat-content">

                <span class="stat-label">
                    Ventas del día
                </span>

                <strong>
                    C$ @Model.VentaDia.ToString("N2")
                </strong>

            </div>

        </article>



        <!-- VENTA SEMANA -->

        <article class="stat-card">

            <div class="stat-header">

                <div class="stat-icon mint">
                    <i class="bi bi-calendar-week"></i>
                </div>

                <span class="stat-badge">
                    Semana
                </span>

            </div>


            <div class="stat-content">

                <span class="stat-label">
                    Ventas de la semana
                </span>

                <strong>
                    C$ @Model.VentaSemana.ToString("N2")
                </strong>

            </div>

        </article>



        <!-- VENTA MES -->

        <article class="stat-card">

            <div class="stat-header">

                <div class="stat-icon dark">
                    <i class="bi bi-calendar3"></i>
                </div>

                <span class="stat-badge">
                    Mes actual
                </span>

            </div>


            <div class="stat-content">

                <span class="stat-label">
                    Ventas del mes
                </span>

                <strong>
                    C$ @Model.VentaMes.ToString("N2")
                </strong>

            </div>

        </article>


    </section>



    <!-- =====================================================
         ALERTAS INVENTARIO
    ====================================================== -->

    <div class="section-heading">

        <div>
            <h2>Estado del inventario</h2>
            <p>Situaciones que necesitan revisión.</p>
        </div>

        <div class="section-icon">
            <i class="bi bi-box-seam"></i>
        </div>

    </div>


    <section class="inventory-grid">


        <!-- POR VENCER -->

        <a href="/Productos/PorVencer"
           class="inventory-card warning">

            <div class="inventory-icon">
                <i class="bi bi-clock-history"></i>
            </div>

            <div class="inventory-content">

                <span>
                    Próximos a vencer
                </span>

                <strong>
                    @Model.PorVencer
                </strong>

                <small>
                    productos requieren revisión
                </small>

            </div>

            <div class="inventory-arrow">
                <i class="bi bi-arrow-right"></i>
            </div>

        </a>



        <!-- SIN STOCK -->

        <a href="/Productos/SinInventario"
           class="inventory-card danger">

            <div class="inventory-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div class="inventory-content">

                <span>
                    Sin existencias
                </span>

                <strong>
                    @Model.SinStock
                </strong>

                <small>
                    productos sin inventario
                </small>

            </div>

            <div class="inventory-arrow">
                <i class="bi bi-arrow-right"></i>
            </div>

        </a>


    </section>



    <!-- =====================================================
         ACCIONES RÁPIDAS
    ====================================================== -->

    <div class="section-heading">

        <div>
            <h2>Acciones rápidas</h2>
            <p>Accede a las operaciones más utilizadas.</p>
        </div>

    </div>


    <section class="quick-grid">


        <a href="/Facturas/Nueva"
           class="quick-card">

            <div class="quick-icon primary">
                <i class="bi bi-receipt-cutoff"></i>
            </div>

            <div>

                <strong>
                    Nueva venta
                </strong>

                <span>
                    Crear factura
                </span>

            </div>

            <i class="bi bi-chevron-right quick-arrow"></i>

        </a>



        <a href="/Inventario"
           class="quick-card">

            <div class="quick-icon soft">
                <i class="bi bi-box-seam"></i>
            </div>

            <div>

                <strong>
                    Inventario
                </strong>

                <span>
                    Consultar existencias
                </span>

            </div>

            <i class="bi bi-chevron-right quick-arrow"></i>

        </a>



        <a href="/Productos/Nuevo"
           class="quick-card">

            <div class="quick-icon light">
                <i class="bi bi-plus-lg"></i>
            </div>

            <div>

                <strong>
                    Nuevo producto
                </strong>

                <span>
                    Registrar artículo
                </span>

            </div>

            <i class="bi bi-chevron-right quick-arrow"></i>

        </a>



        <a href="/Reportes"
           class="quick-card">

            <div class="quick-icon neutral">
                <i class="bi bi-bar-chart-line"></i>
            </div>

            <div>

                <strong>
                    Reportes
                </strong>

                <span>
                    Consultar información
                </span>

            </div>

            <i class="bi bi-chevron-right quick-arrow"></i>

        </a>


    </section>



    <!-- =====================================================
         RESUMEN FINANCIERO
    ====================================================== -->

    <div class="section-heading">

        <div>
            <h2>Resumen financiero</h2>
            <p>Resultados correspondientes al mes actual.</p>
        </div>

        <span class="month-badge">
            <i class="bi bi-calendar3"></i>
            Mes actual
        </span>

    </div>


    <section class="financial-card">


        <div class="financial-item">

            <div class="financial-icon">
                <i class="bi bi-wallet2"></i>
            </div>

            <div>

                <span>
                    Venta total
                </span>

                <strong>
                    C$ @Model.UtilVenta.ToString("N2")
                </strong>

            </div>

        </div>


        <div class="financial-divider"></div>


        <div class="financial-item">

            <div class="financial-icon">
                <i class="bi bi-truck"></i>
            </div>

            <div>

                <span>
                    Costo total
                </span>

                <strong>
                    C$ @Model.UtilCosto.ToString("N2")
                </strong>

            </div>

        </div>


        <div class="financial-divider"></div>


        <div class="financial-item highlight">

            <div class="financial-icon">
                <i class="bi bi-graph-up-arrow"></i>
            </div>

            <div>

                <span>
                    Utilidad
                </span>

                <strong>
                    C$ @Model.UtilUtilidad.ToString("N2")
                </strong>

            </div>

        </div>


    </section>



    <!-- =====================================================
         PARTE INFERIOR
    ====================================================== -->

    <section class="dashboard-bottom">


        <!-- PRODUCTOS MÁS VENDIDOS -->

        <div class="dashboard-panel">

            <div class="panel-header">

                <div>
                    <h3>Productos más vendidos</h3>
                    <p>Movimiento destacado del período.</p>
                </div>

                <div class="panel-icon">
                    <i class="bi bi-trophy"></i>
                </div>

            </div>


            @if (Model.TopProductos != null &&
                 Model.TopProductos.Any())
            {

                <div class="products-list">

                    @{
                        var posicion = 1;
                    }

                    @foreach (var producto in Model.TopProductos.Take(5))
                    {

                        <div class="product-row">

                            <div class="product-position">
                                @posicion
                            </div>

                            <div class="product-info">

                                <strong>
                                    @producto.CodBarra
                                </strong>

                                <span>
                                    @producto.Unidades unidades vendidas
                                </span>

                            </div>

                            <div class="product-total">
                                C$ @producto.SubTotal.ToString("N2")
                            </div>

                        </div>

                        posicion++;
                    }

                </div>

            }
            else
            {

                <div class="empty-state">

                    <i class="bi bi-box"></i>

                    <span>
                        No hay información disponible.
                    </span>

                </div>

            }

        </div>



        <!-- ALERTAS -->

        <div class="dashboard-panel">

            <div class="panel-header">

                <div>
                    <h3>Alertas del sistema</h3>
                    <p>Información que requiere tu atención.</p>
                </div>

                <div class="panel-icon alert">
                    <i class="bi bi-bell"></i>
                </div>

            </div>


            <div class="alerts-list">


                <a href="/Productos/SinInventario"
                   class="alert-item danger">

                    <div class="alert-icon">

                        <i class="bi bi-exclamation-lg"></i>

                    </div>

                    <div>

                        <strong>
                            Productos sin inventario
                        </strong>

                        <span>
                            @Model.SinStock productos necesitan revisión.
                        </span>

                    </div>

                </a>


                <a href="/Productos/PorVencer"
                   class="alert-item warning">

                    <div class="alert-icon">

                        <i class="bi bi-clock"></i>

                    </div>

                    <div>

                        <strong>
                            Productos próximos a vencer
                        </strong>

                        <span>
                            @Model.PorVencer productos requieren seguimiento.
                        </span>

                    </div>

                </a>


                <div class="alert-item success">

                    <div class="alert-icon">

                        <i class="bi bi-shield-check"></i>

                    </div>

                    <div>

                        <strong>
                            Sistema operativo
                        </strong>

                        <span>
                            Información actualizada correctamente.
                        </span>

                    </div>

                </div>


            </div>

        </div>


    </section>

</div>