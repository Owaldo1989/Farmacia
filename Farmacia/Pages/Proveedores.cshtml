@page
@model Farmacia.Pages.ProveedoresModel
@{
    ViewData["Title"] = "Proveedores";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold">Proveedores</h3>

        <button class="btn btn-primary" onclick="nuevoProveedor()">
            ➕ Nuevo Proveedor
        </button>
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width:80px;">ID</th>
                    <th>Nombre</th>
                    <th>Contacto</th>
                    <th>Teléfono</th>
                    <th style="width:170px;" class="text-center">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var p in Model.Listado)
                {
                    <tr>
                        <td>@p.IdProveedor</td>
                        <td>@p.NombreProveedor</td>
                        <td>@p.Contacto</td>
                        <td>@p.Telefono</td>

                        <td class="text-center">

                            <button class="btn btn-warning btn-sm btn-accion"
                                    onclick="editar(@p.IdProveedor)">
                                ✏️ Editar
                            </button>

                            <button class="btn btn-danger btn-sm btn-accion"
                                    onclick="eliminar(@p.IdProveedor)">
                                🗑️ Borrar
                            </button>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>


<!-- MODAL -->
<div class="modal fade" id="modalProveedor" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Proveedor</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="Proveedor_IdProveedor"
                           name="Proveedor.IdProveedor"
                           value="@Model.Proveedor?.IdProveedor" />

                    <div class="mb-3">
                        <label class="form-label">Nombre Proveedor</label>
                        <input class="form-control"
                               asp-for="Proveedor.NombreProveedor"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Contacto</label>
                        <input class="form-control"
                               asp-for="Proveedor.Contacto" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Teléfono</label>
                        <input class="form-control"
                               asp-for="Proveedor.Telefono" />
                    </div>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-primary">Guardar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>

            </form>

        </div>
    </div>
</div>


@section Scripts {
    <script>

        function nuevoProveedor() {
            document.getElementById("Proveedor_IdProveedor").value = 0;
            document.getElementById("Proveedor_NombreProveedor").value = "";
            document.getElementById("Proveedor_Contacto").value = "";
            document.getElementById("Proveedor_Telefono").value = "";

            new bootstrap.Modal(document.getElementById("modalProveedor")).show();
        }

        function editar(id) {
            window.location.href = "/Proveedores?id=" + id;
        }

        function eliminar(id) {
            Swal.fire({
                title: "¿Eliminar proveedor?",
                text: "Esta acción no se puede deshacer.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Sí, eliminar",
                cancelButtonText: "Cancelar"
            }).then((r) => {
                if (r.isConfirmed) {
                    window.location.href = "/Proveedores?eliminar=" + id;
                }
            });
        }

        // MENSAJE OK
        @if (TempData["Ok"] != null)
        {
            <text>
            Swal.fire({
                icon: "success",
                title: "Completado",
                text: "@TempData["Ok"]",
                timer: 1800,
                showConfirmButton: false
            });
            </text>
        }

        // MENSAJE ERROR
        @if (TempData["Error"] != null)
        {
            <text>
            Swal.fire({
                icon: "error",
                title: "Error",
                text: "@TempData["Error"]"
            });
            </text>
        }

        // ABRIR MODAL SI ES EDICIÓN
        @if (TempData["Editar"] != null)
        {
            <text>
            document.addEventListener("DOMContentLoaded", function() {
                new bootstrap.Modal(document.getElementById("modalProveedor")).show();
            });
            </text>
        }

    </script>
}
