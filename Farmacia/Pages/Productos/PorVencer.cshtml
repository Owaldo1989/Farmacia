@page
@model Farmacia.Pages.Productos.PorVencerModel

@{
    ViewData["Title"] = "Productos Próximos a Vencer";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<style>
    .card-producto {
        border-radius: 14px;
        background: #ffffff;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        transition: transform .2s;
        border-left: 6px solid #ffc107;
    }
    .card-producto:hover {
        transform: translateY(-4px);
    }

    .estado-badge {
        font-size: 0.85rem;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
    }

    .estado-vencido {
        background: #dc3545;
        color: white;
    }

    .estado-proximo {
        background: #ffc107;
        color: #333;
    }

    .estado-ok {
        background: #28a745;
        color: white;
    }

    .titulo {
        font-weight: 700;
        color: #b40000;
    }
</style>

<h3 class="fw-bold mb-4 titulo">
    <i class="bi bi-hourglass-split"></i> Productos Próximos a Vencer
</h3>

<div class="row g-3">
    @foreach (var p in Model.Lista)
    {
        var estadoClase = "";
        var estadoTexto = "";

        if (p.DiasRestantes < 0)
        {
            estadoClase = "estado-vencido";
            estadoTexto = "Vencido";
        }
        else if (p.DiasRestantes <= 15)
        {
            estadoClase = "estado-proximo";
            estadoTexto = "Próximo a vencer";
        }
        else
        {
            estadoClase = "estado-ok";
            estadoTexto = "En buen estado";
        }

        <div class="col-md-4">
            <div class="card-producto">

                <div class="d-flex justify-content-between align-items-start">
                    <h5 class="fw-bold">@p.Nombre</h5>
                    <span class="estado-badge @estadoClase">@estadoTexto</span>
                </div>

                <div class="mt-2">
                    <p class="mb-1"><b>Código:</b> @p.CodBarra</p>
                    <p class="mb-1">
                        <b>Vence:</b> @p.FechaVence.ToString("dd/MM/yyyy")
                    </p>

                    <p class="mb-1">
                        <b>Días restantes:</b> 
                        <span class="fw-bold">
                            @p.DiasRestantes
                        </span>
                    </p>

                    <p class="mb-0">
                        <b>Stock:</b> @p.Stock
                    </p>
                </div>

            </div>
        </div>
    }
</div>

<a href="/Index" class="btn btn-secondary mt-4">
    <i class="bi bi-arrow-left"></i> Volver al Dashboard
</a>
