@{
    var ruta =
        Context.Request.Path.Value?.ToLower() ?? "";


    // =========================================================
    // PRINCIPAL
    // =========================================================

    var esInicio =
        ruta == "/" ||
        ruta == "/index";


    var principalActivo =
        esInicio;


    // =========================================================
    // VENTAS
    // =========================================================

    var esNuevaVenta =
        ruta == "/facturas/nueva";

    var esListaFacturas =
        ruta == "/facturas/lista";

    var esFacturas =
        ruta.StartsWith("/facturas");


    var ventasActivo =
        esFacturas;


    // =========================================================
    // INVENTARIO
    // =========================================================

    var esInventario =
        ruta.StartsWith("/inventario");

    var esNuevoIngreso =
        ruta == "/ingresos/nuevo";

    var esListaIngresos =
        ruta == "/ingresos/lista";

    var esIngresos =
        ruta.StartsWith("/ingresos");


    var inventarioActivo =
        esInventario ||
        esIngresos;


    // =========================================================
    // CAJA OPERATIVA
    // IMPORTANTE:
    // /caja/ NO debe confundirse con /cajas
    // =========================================================

    var esCajaOperacion =
        ruta.StartsWith("/caja/");

    var esAgenteBanpro =
        ruta == "/agentes/operaciones/banpro" ||
        ruta.StartsWith("/agentes/banpro");

    var esAgenteBac =
        ruta == "/agentes/operaciones/bac" ||
        ruta.StartsWith("/agentes/bac");

    var esAgentesConfiguracion =
        ruta.StartsWith("/agentes/agentesbancarios");


    var cajaActivo =
        esCajaOperacion;


    var serviciosFinancierosActivo =
        esAgenteBanpro ||
        esAgenteBac ||
        ruta.StartsWith("/agentes/operaciones");

    // =========================================================
    // CATÁLOGOS
    // =========================================================

    var esProductos =
        ruta.StartsWith("/productos");

    var esCategorias =
        ruta.StartsWith("/categorias");

    var esUnidades =
        ruta.StartsWith("/unidades");

    var esProveedores =
        ruta.StartsWith("/proveedores");

    var esLaboratorios =
        ruta.StartsWith("/laboratorio") ||
        ruta.StartsWith("/laboratorios");


    var catalogosActivo =
        esProductos ||
        esCategorias ||
        esUnidades ||
        esProveedores ||
        esLaboratorios;


    // =========================================================
    // ADMINISTRACIÓN
    // =========================================================

    var esSucursales =
        ruta.StartsWith("/sucursales");

    var esBodegas =
        ruta.StartsWith("/bodegas");

    var esCajas =
        ruta.StartsWith("/cajas");

    var esUsuarios =
        ruta.StartsWith("/usuarios");

    var esDenominaciones =
        ruta.StartsWith("/denominaciones");

    var esAgentes =
        esAgentesConfiguracion;

    var esTipoCambio =
        ruta.StartsWith("/configuracion/tipocambio");


    var administracionActivo =
        esSucursales ||
        esBodegas ||
        esCajas ||
        esUsuarios ||
        esDenominaciones ||
        esAgentes ||
        esTipoCambio;


    // =========================================================
    // REPORTES
    // =========================================================

    var esReportes =
        ruta.StartsWith("/reportes");


    var reportesActivo =
        esReportes;


    // =========================================================
    // USUARIO
    // =========================================================

    var nombre =
        Context.Session.GetString("Nombre");

    var rol =
        Farmacia.Helpers.RolHelper.NormalizarRol(
            Context.Session.GetString("Rol")
        );


    var esAdministrador =
        Farmacia.Helpers.RolHelper.EsAdministrador(
            rol
        );
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Farmacia
    </title>


    <!-- BOOTSTRAP -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- ICONOS -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- FUENTE -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">


    <!-- ===================================================
         PALETA GLOBAL
    ==================================================== -->

    <link rel="stylesheet"
          href="~/css/theme.css"
          asp-append-version="true" />


    <!-- CSS EXISTENTES -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/catalogos.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/tablas.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/formularios.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />


    <!-- LAYOUT NUEVO -->

    <link rel="stylesheet"
          href="~/css/layout.css"
          asp-append-version="true" />


    <link rel="stylesheet"
          href="~/Farmacia.styles.css"
          asp-append-version="true" />

</head>


<body>


    <!-- =====================================================
         SIDEBAR OVERLAY MÓVIL
    ====================================================== -->

    <div class="sidebar-overlay"
         id="sidebarOverlay"></div>



    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="app-sidebar"
           id="appSidebar">


        <!-- LOGO -->

        <div class="sidebar-brand">

            <div class="brand-symbol">

                <i class="bi bi-capsule"></i>

            </div>


            <div class="brand-text">

                <strong>
                    Farmacia
                </strong>

                <span>
                    Sistema de gestión
                </span>

            </div>


            <button type="button"
                    class="sidebar-close"
                    id="sidebarClose">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>



        <!-- =================================================
             MENÚ
        ================================================== -->

      <nav class="sidebar-navigation">


    <!-- =====================================================
         PRINCIPAL
    ====================================================== -->

    <span class="sidebar-title">
        PRINCIPAL
    </span>


    <button class="sidebar-link sidebar-dropdown-button @(principalActivo ? "active" : "")"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#menuPrincipal"
            aria-expanded="@(principalActivo ? "true" : "false")"
            aria-controls="menuPrincipal">

        <span class="sidebar-icon">
            <i class="bi bi-grid"></i>
        </span>

        <span class="sidebar-link-text">
            Principal
        </span>

        <i class="bi bi-chevron-down submenu-arrow"></i>

    </button>


    <div class="collapse @(principalActivo ? "show" : "")"
         id="menuPrincipal">

        <div class="sidebar-submenu">

            <a href="/Index"
               class="submenu-link @(esInicio ? "active" : "")">

                <span class="submenu-dot"></span>

                Inicio

            </a>

        </div>

    </div>



    <!-- =====================================================
         VENTAS
    ====================================================== -->

    <span class="sidebar-title sidebar-group-title">
        VENTAS
    </span>


    <button class="sidebar-link sidebar-dropdown-button @(ventasActivo ? "active" : "")"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#menuVentas"
            aria-expanded="@(ventasActivo ? "true" : "false")"
            aria-controls="menuVentas">

        <span class="sidebar-icon">

            <i class="bi bi-receipt"></i>

        </span>


        <span class="sidebar-link-text">
            Ventas
        </span>


        <i class="bi bi-chevron-down submenu-arrow"></i>

    </button>


    <div class="collapse @(ventasActivo ? "show" : "")"
         id="menuVentas">

        <div class="sidebar-submenu">


            <!-- NUEVA VENTA -->

            <a href="/Facturas/Nueva"
               class="submenu-link @(esNuevaVenta ? "active" : "")">

                <span class="submenu-dot"></span>

                Nueva venta

            </a>

            <!-- FACTURAS -->

            <a href="/Facturas/Lista"
               class="submenu-link @(esListaFacturas ? "active" : "")">

                <span class="submenu-dot"></span>

                Facturas

            </a>

        </div>

    </div>



    <!-- =====================================================
         INVENTARIO
    ====================================================== -->

    <span class="sidebar-title sidebar-group-title">
        INVENTARIO
    </span>


    <button class="sidebar-link sidebar-dropdown-button @(inventarioActivo ? "active" : "")"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#menuInventario"
            aria-expanded="@(inventarioActivo ? "true" : "false")"
            aria-controls="menuInventario">

        <span class="sidebar-icon">

            <i class="bi bi-box-seam"></i>

        </span>


        <span class="sidebar-link-text">
            Inventario
        </span>


        <i class="bi bi-chevron-down submenu-arrow"></i>

    </button>


    <div class="collapse @(inventarioActivo ? "show" : "")"
         id="menuInventario">

        <div class="sidebar-submenu">


            <!-- EXISTENCIAS -->

            <a href="/Inventario"
               class="submenu-link @(esInventario ? "active" : "")">

                <span class="submenu-dot"></span>

                Inventario

            </a>


            <!-- NUEVO INGRESO -->

            <a href="/Ingresos/Nuevo"
               class="submenu-link @(esNuevoIngreso ? "active" : "")">

                <span class="submenu-dot"></span>

                Nuevo ingreso

            </a>


            <!-- HISTORIAL INGRESOS -->

            <a href="/Ingresos/Lista"
               class="submenu-link @(esListaIngresos ? "active" : "")">

                <span class="submenu-dot"></span>

                Historial ingresos

            </a>

        </div>

    </div>



    <!-- =====================================================
         CAJA
    ====================================================== -->

    <span class="sidebar-title sidebar-group-title">
        CAJA
    </span>


    <button class="sidebar-link sidebar-dropdown-button @(cajaActivo ? "active" : "")"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#menuCaja"
            aria-expanded="@(cajaActivo ? "true" : "false")"
            aria-controls="menuCaja">

        <span class="sidebar-icon">

            <i class="bi bi-cash-stack"></i>

        </span>


        <span class="sidebar-link-text">
            Caja
        </span>


        <i class="bi bi-chevron-down submenu-arrow"></i>

    </button>


    <div class="collapse @(cajaActivo ? "show" : "")"
         id="menuCaja">

        <div class="sidebar-submenu">


            <!-- OPERAR CAJA -->

            <a href="/Caja/Apertura"
               class="submenu-link @(esCajaOperacion ? "active" : "")">

                <span class="submenu-dot"></span>

                Operar caja

            </a>

        </div>

    </div>



    <span class="sidebar-title sidebar-group-title">
        SERVICIOS FINANCIEROS
    </span>


    <button class="sidebar-link sidebar-dropdown-button @(serviciosFinancierosActivo ? "active" : "")"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#menuServiciosFinancieros"
            aria-expanded="@(serviciosFinancierosActivo ? "true" : "false")"
            aria-controls="menuServiciosFinancieros">

        <span class="sidebar-icon">

            <i class="bi bi-bank"></i>

        </span>


        <span class="sidebar-link-text">
            Servicios financieros
        </span>


        <i class="bi bi-chevron-down submenu-arrow"></i>

    </button>


    <div class="collapse @(serviciosFinancierosActivo ? "show" : "")"
         id="menuServiciosFinancieros">

        <div class="sidebar-submenu">

            <a href="/Agentes/Operaciones/BANPRO"
               class="submenu-link @(esAgenteBanpro ? "active" : "")">

                <span class="submenu-dot"></span>

                Agente Banpro

            </a>


            <a href="/Agentes/Operaciones/BAC"
               class="submenu-link @(esAgenteBac ? "active" : "")">

                <span class="submenu-dot"></span>

                Agente BAC

            </a>

        </div>

    </div>

    <!-- =====================================================
         CATÁLOGOS
    ====================================================== -->

    <span class="sidebar-title sidebar-group-title">
        CATÁLOGOS
    </span>


    <button class="sidebar-link sidebar-dropdown-button @(catalogosActivo ? "active" : "")"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#menuCatalogos"
            aria-expanded="@(catalogosActivo ? "true" : "false")"
            aria-controls="menuCatalogos">

        <span class="sidebar-icon">

            <i class="bi bi-folder2-open"></i>

        </span>


        <span class="sidebar-link-text">
            Catálogos
        </span>


        <i class="bi bi-chevron-down submenu-arrow"></i>

    </button>


    <div class="collapse @(catalogosActivo ? "show" : "")"
         id="menuCatalogos">

        <div class="sidebar-submenu">


            <!-- PRODUCTOS -->

            <a href="/Productos/Nuevo"
               class="submenu-link @(esProductos ? "active" : "")">

                <span class="submenu-dot"></span>

                Productos

            </a>


            <!-- CATEGORÍAS -->

            <a href="/Categorias"
               class="submenu-link @(esCategorias ? "active" : "")">

                <span class="submenu-dot"></span>

                Categorías

            </a>


            <!-- UNIDADES -->

            <a href="/Unidades"
               class="submenu-link @(esUnidades ? "active" : "")">

                <span class="submenu-dot"></span>

                Unidades de medida

            </a>


            <!-- LABORATORIOS -->

            <a href="/Laboratorio/Laboratorio"
               class="submenu-link @(esLaboratorios ? "active" : "")">

                <span class="submenu-dot"></span>

                Laboratorios

            </a>


            <!-- PROVEEDORES -->

            <a href="/Proveedores"
               class="submenu-link @(esProveedores ? "active" : "")">

                <span class="submenu-dot"></span>

                Proveedores

            </a>


        </div>

    </div>



    <!-- =====================================================
         ADMINISTRACIÓN
         SOLO ADMINISTRADORES
    ====================================================== -->

    @if (esAdministrador)
    {

        <span class="sidebar-title sidebar-group-title">
            ADMINISTRACIÓN
        </span>


        <button class="sidebar-link sidebar-dropdown-button @(administracionActivo ? "active" : "")"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menuAdministracion"
                aria-expanded="@(administracionActivo ? "true" : "false")"
                aria-controls="menuAdministracion">

            <span class="sidebar-icon">

                <i class="bi bi-sliders"></i>

            </span>


            <span class="sidebar-link-text">
                Configuración
            </span>


            <i class="bi bi-chevron-down submenu-arrow"></i>

        </button>


        <div class="collapse @(administracionActivo ? "show" : "")"
             id="menuAdministracion">

            <div class="sidebar-submenu">


                <!-- SUCURSALES -->

                <a href="/Sucursales"
                   class="submenu-link @(esSucursales ? "active" : "")">

                    <span class="submenu-dot"></span>

                    Sucursales

                </a>


                <!-- BODEGAS -->

                <a href="/Bodegas"
                   class="submenu-link @(esBodegas ? "active" : "")">

                    <span class="submenu-dot"></span>

                    Bodegas

                </a>


                <!-- CAJAS -->

                <a href="/Cajas"
                   class="submenu-link @(esCajas ? "active" : "")">

                    <span class="submenu-dot"></span>

                    Cajas

                </a>


                <!-- USUARIOS -->

                <a href="/Usuarios"
                   class="submenu-link @(esUsuarios ? "active" : "")">

                    <span class="submenu-dot"></span>

                    Usuarios

                </a>


                <!-- DENOMINACIONES -->

                <a href="/Denominaciones"
                   class="submenu-link @(esDenominaciones ? "active" : "")">

                    <span class="submenu-dot"></span>

                    Denominaciones

                </a>


                <!-- AGENTES BANCARIOS -->

                <a href="/Agentes/AgentesBancarios"
                   class="submenu-link @(esAgentes ? "active" : "")">

                    <span class="submenu-dot"></span>

                    Agentes bancarios

                </a>


                <!-- TIPO CAMBIO -->

                <a href="/Configuracion/TipoCambio"
                   class="submenu-link @(esTipoCambio ? "active" : "")">

                    <span class="submenu-dot"></span>

                    Tipo de cambio

                </a>


            </div>

        </div>

    }



    <!-- =====================================================
         REPORTES
    ====================================================== -->

    <span class="sidebar-title sidebar-group-title">
        REPORTES
    </span>


    <button class="sidebar-link sidebar-dropdown-button @(reportesActivo ? "active" : "")"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#menuReportes"
            aria-expanded="@(reportesActivo ? "true" : "false")"
            aria-controls="menuReportes">

        <span class="sidebar-icon">

            <i class="bi bi-bar-chart-line"></i>

        </span>


        <span class="sidebar-link-text">
            Reportes
        </span>


        <i class="bi bi-chevron-down submenu-arrow"></i>

    </button>


    <div class="collapse @(reportesActivo ? "show" : "")"
         id="menuReportes">

        <div class="sidebar-submenu">

            <a href="/Reportes"
               class="submenu-link @(esReportes ? "active" : "")">

                <span class="submenu-dot"></span>

                Reportes

            </a>

        </div>

    </div>


</nav>


      



        <!-- =================================================
             USUARIO
        ================================================== -->

        <div class="sidebar-user">


            <div class="sidebar-user-avatar">

                <i class="bi bi-person"></i>

            </div>


            <div class="sidebar-user-info">

                <strong>
                    @nombre
                </strong>

                <span>
                    @rol
                </span>

            </div>


            <a href="/Login"
               class="sidebar-logout"
               title="Cerrar sesión">

                <i class="bi bi-box-arrow-right"></i>

            </a>


        </div>


    </aside>



    <!-- =====================================================
         APLICACIÓN
    ====================================================== -->

    <div class="app-wrapper">


        <!-- =================================================
             TOPBAR
        ================================================== -->

        <header class="app-topbar">


            <div class="topbar-left">


                <!-- BOTÓN MÓVIL -->

                <button class="mobile-menu-button"
                        id="sidebarOpen"
                        type="button">

                    <i class="bi bi-list"></i>

                </button>



                <!-- TÍTULO -->

                <div class="topbar-page-title">

                    <span>
                        Sistema Farmacia
                    </span>

                    <strong>
                        @ViewData["Title"]
                    </strong>

                </div>


            </div>



            <div class="topbar-right">


                <!-- INDICADOR -->

                <div class="system-status">

                    <span class="status-dot"></span>

                    Sistema activo

                </div>



                <!-- USUARIO -->

                <div class="dropdown">


                    <button class="topbar-user"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">


                        <div class="topbar-avatar">

                            <i class="bi bi-person"></i>

                        </div>


                        <div class="topbar-user-info">

                            <strong>
                                @nombre
                            </strong>

                            <span>
                                @rol
                            </span>

                        </div>


                        <i class="bi bi-chevron-down"></i>


                    </button>



                    <ul class="dropdown-menu dropdown-menu-end user-dropdown">


                        <li>

                            <div class="dropdown-user-header">

                                <strong>
                                    @nombre
                                </strong>

                                <span>
                                    @rol
                                </span>

                            </div>

                        </li>


                        <li>
                            <hr class="dropdown-divider">
                        </li>


                        <li>

                            <a class="dropdown-item logout-item"
                               href="/Login">

                                <i class="bi bi-box-arrow-right"></i>

                                Cerrar sesión

                            </a>

                        </li>


                    </ul>


                </div>


            </div>


        </header>



        <!-- =================================================
             CONTENIDO
        ================================================== -->

        <main class="app-content"
              role="main">


            @RenderBody()


        </main>



        <!-- =================================================
             FOOTER
        ================================================== -->

        <footer class="app-footer">

            <span>

                Sistema de Gestión Farmacéutica

            </span>


            <span>

                <i class="bi bi-shield-check"></i>

                Acceso seguro

            </span>

        </footer>


    </div>



    <!-- =====================================================
         JS
    ====================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>



    <script>

        const sidebar =
            document.getElementById("appSidebar");

        const sidebarOpen =
            document.getElementById("sidebarOpen");

        const sidebarClose =
            document.getElementById("sidebarClose");

        const sidebarOverlay =
            document.getElementById("sidebarOverlay");


        function abrirSidebar() {

            sidebar.classList.add("show");

            sidebarOverlay.classList.add("show");

            document.body.classList.add("sidebar-open");

        }


        function cerrarSidebar() {

            sidebar.classList.remove("show");

            sidebarOverlay.classList.remove("show");

            document.body.classList.remove("sidebar-open");

        }


        sidebarOpen?.addEventListener(
            "click",
            abrirSidebar
        );


        sidebarClose?.addEventListener(
            "click",
            cerrarSidebar
        );


        sidebarOverlay?.addEventListener(
            "click",
            cerrarSidebar
        );


        window.addEventListener(
            "resize",
            function () {

                if (window.innerWidth > 991) {

                    cerrarSidebar();

                }

            }
        );

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )


</body>

</html>
