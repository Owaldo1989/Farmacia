@page
@model Farmacia.Pages.CategoriasModel

@{
    ViewData["Title"] = "Categorías";

    var totalCategorias =
        Model.Listado?.Count ?? 0;
}

<link rel="stylesheet"
      href="~/css/categorias.css"
      asp-append-version="true" />


<div class="categories-page">


    <!-- =====================================================
         ENCABEZADO
    ====================================================== -->

    <section class="categories-header">

        <div>

            <div class="categories-eyebrow">

                <i class="bi bi-tags"></i>

                Catálogo

            </div>


            <h1>
                Categorías
            </h1>


            <p>
                Organiza los productos de la farmacia
                mediante categorías para facilitar su clasificación.
            </p>

        </div>


        <button type="button"
                class="btn-new-category"
                onclick="nuevaCategoria()">

            <i class="bi bi-plus-lg"></i>

            Nueva categoría

        </button>

    </section>



    <!-- =====================================================
         RESUMEN
    ====================================================== -->

    <section class="categories-summary">


        <div class="category-summary-icon">

            <i class="bi bi-tags"></i>

        </div>


        <div class="category-summary-data">

            <span>
                Categorías registradas
            </span>

            <strong>
                @totalCategorias
            </strong>

        </div>


        <div class="category-summary-help">

            <i class="bi bi-info-circle"></i>

            <span>
                Las categorías permiten agrupar productos
                similares dentro del catálogo.
            </span>

        </div>


    </section>



    <!-- =====================================================
         BUSCADOR
    ====================================================== -->

    <section class="categories-toolbar">


        <div class="category-search">

            <i class="bi bi-search"></i>


            <input type="text"
                   id="txtBuscarCategoria"
                   placeholder="Buscar categoría..."
                   autocomplete="off" />


            <button type="button"
                    id="btnLimpiarCategoria"
                    class="btn-clear-category"
                    title="Limpiar búsqueda"
                    style="display:none;">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>


        <div class="category-results">

            <strong id="contadorCategorias">
                @totalCategorias
            </strong>

            <span>
                resultados
            </span>

        </div>


    </section>



    <!-- =====================================================
         LISTADO
    ====================================================== -->

    <section class="categories-card">


        <div class="categories-card-header">


            <div>

                <h2>
                    Listado de categorías
                </h2>

                <p>
                    Categorías disponibles para clasificar productos.
                </p>

            </div>


            <div class="categories-card-icon">

                <i class="bi bi-list-ul"></i>

            </div>


        </div>



        @if (Model.Listado != null &&
             Model.Listado.Any())
        {

            <div class="categories-table-wrapper">


                <table class="categories-table">


                    <thead>

                        <tr>

                            <th class="category-id-column">
                                Código
                            </th>

                            <th>
                                Categoría
                            </th>

                            <th class="category-actions-column">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody id="categoriasBody">


                        @foreach (var categoria in Model.Listado)
                        {

                            <tr class="category-row"
                                data-categoria="@categoria.NombreCategoria?.ToLower()">


                                <!-- ID -->

                                <td>

                                    <span class="category-id">

                                        #@categoria.IdCategoria

                                    </span>

                                </td>



                                <!-- NOMBRE -->

                                <td>

                                    <div class="category-information">


                                        <div class="category-avatar">

                                            <i class="bi bi-tag"></i>

                                        </div>


                                        <div class="category-name">

                                            <strong>

                                                @categoria.NombreCategoria

                                            </strong>


                                            <span>

                                                Categoría de productos

                                            </span>

                                        </div>


                                    </div>

                                </td>



                                <!-- ACCIONES -->

                                <td>

                                    <div class="category-actions">


                                        <button type="button"
                                                class="category-action edit"
                                                onclick="editarCategoria(@categoria.IdCategoria)">

                                            <i class="bi bi-pencil"></i>

                                            <span>
                                                Editar
                                            </span>

                                        </button>


                                        <button type="button"
                                                class="category-action delete"
                                                onclick="eliminarCategoria(@categoria.IdCategoria)"
                                                title="Eliminar categoría">

                                            <i class="bi bi-trash3"></i>

                                        </button>


                                    </div>

                                </td>


                            </tr>

                        }


                    </tbody>


                </table>


            </div>



            <!-- SIN RESULTADOS -->

            <div class="categories-no-results"
                 id="sinResultadosCategoria"
                 style="display:none;">


                <div class="categories-empty-icon">

                    <i class="bi bi-search"></i>

                </div>


                <strong>
                    No encontramos categorías
                </strong>


                <span>
                    Intenta buscar utilizando otro nombre.
                </span>


                <button type="button"
                        onclick="limpiarBusquedaCategoria()">

                    Limpiar búsqueda

                </button>


            </div>

        }
        else
        {

            <div class="categories-empty">


                <div class="categories-empty-icon">

                    <i class="bi bi-tags"></i>

                </div>


                <strong>
                    No hay categorías registradas
                </strong>


                <span>
                    Crea la primera categoría para comenzar
                    a clasificar los productos.
                </span>


                <button type="button"
                        onclick="nuevaCategoria()">

                    <i class="bi bi-plus-lg"></i>

                    Nueva categoría

                </button>


            </div>

        }


    </section>


</div>



<!-- =========================================================
     MODAL
========================================================== -->

<div class="modal fade"
     id="modalCategoria"
     tabindex="-1"
     aria-hidden="true">


    <div class="modal-dialog modal-dialog-centered">


        <div class="modal-content category-modal">


            <form method="post"
                  id="formCategoria">


                <!-- HEADER -->

                <div class="modal-header category-modal-header">


                    <div class="category-modal-title">


                        <div class="category-modal-icon">

                            <i class="bi bi-tag"></i>

                        </div>


                        <div>

                            <h5 id="modalCategoriaTitulo">

                                Nueva categoría

                            </h5>


                            <span id="modalCategoriaSubtitulo">

                                Registra una nueva categoría de productos.

                            </span>

                        </div>


                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>


                </div>



                <!-- BODY -->

                <div class="modal-body category-modal-body">


                    <input type="hidden"
                           id="Categoria_IdCategoria"
                           name="Categoria.IdCategoria"
                           value="@Model.Categoria?.IdCategoria" />


                    <div class="category-field">


                        <label asp-for="Categoria.NombreCategoria">

                            Nombre de la categoría

                            <span>*</span>

                        </label>


                        <div class="category-input">

                            <i class="bi bi-tag"></i>


                            <input asp-for="Categoria.NombreCategoria"
                                   maxlength="150"
                                   autocomplete="off"
                                   placeholder="Ej. Analgésicos"
                                   required />

                        </div>


                        <span asp-validation-for="Categoria.NombreCategoria"
                              class="category-validation">
                        </span>


                        <small>
                            Utiliza un nombre corto y fácil de identificar.
                        </small>


                    </div>


                </div>



                <!-- FOOTER -->

                <div class="modal-footer category-modal-footer">


                    <button type="button"
                            class="btn-category-cancel"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>


                    <button type="submit"
                            class="btn-category-save"
                            id="btnGuardarCategoria">

                        <i class="bi bi-check-lg"></i>

                        <span id="textoGuardarCategoria">

                            Guardar categoría

                        </span>

                    </button>


                </div>


            </form>


        </div>


    </div>


</div>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>


        // =====================================================
        // NUEVA CATEGORÍA
        // =====================================================

        function nuevaCategoria() {

            document.getElementById(
                "Categoria_IdCategoria"
            ).value = 0;


            document.getElementById(
                "Categoria_NombreCategoria"
            ).value = "";


            document.getElementById(
                "modalCategoriaTitulo"
            ).textContent =
                "Nueva categoría";


            document.getElementById(
                "modalCategoriaSubtitulo"
            ).textContent =
                "Registra una nueva categoría de productos.";


            document.getElementById(
                "textoGuardarCategoria"
            ).textContent =
                "Guardar categoría";


            const modal =
                new bootstrap.Modal(
                    document.getElementById(
                        "modalCategoria"
                    )
                );


            modal.show();


            document
                .getElementById(
                    "modalCategoria"
                )
                .addEventListener(
                    "shown.bs.modal",
                    function () {

                        document.getElementById(
                            "Categoria_NombreCategoria"
                        ).focus();

                    },
                    {
                        once: true
                    }
                );

        }



        // =====================================================
        // EDITAR
        // =====================================================

        function editarCategoria(id) {

            window.location.href =
                "/Categorias?id=" + id;

        }



        // =====================================================
        // ELIMINAR
        // =====================================================

        function eliminarCategoria(id) {

            Swal.fire({

                title:
                    "¿Eliminar categoría?",

                text:
                    "Esta acción no se puede deshacer.",

                icon:
                    "warning",

                showCancelButton:
                    true,

                confirmButtonText:
                    "Sí, eliminar",

                cancelButtonText:
                    "Cancelar",

                confirmButtonColor:
                    "#d6535d"

            })
            .then((resultado) => {

                if (resultado.isConfirmed) {

                    window.location.href =
                        "/Categorias?eliminar=" +
                        id;

                }

            });

        }



        // =====================================================
        // BUSCADOR
        // =====================================================

        const inputCategoria =
            document.getElementById(
                "txtBuscarCategoria"
            );


        const btnLimpiarCategoria =
            document.getElementById(
                "btnLimpiarCategoria"
            );



        inputCategoria?.addEventListener(
            "input",
            filtrarCategorias
        );



        function filtrarCategorias() {

            const filtro =
                inputCategoria.value
                    .trim()
                    .toLowerCase();


            const filas =
                document.querySelectorAll(
                    ".category-row"
                );


            let visibles = 0;


            filas.forEach(fila => {

                const nombre =
                    fila.dataset.categoria || "";


                const mostrar =
                    nombre.includes(filtro);


                fila.style.display =
                    mostrar
                        ? ""
                        : "none";


                if (mostrar) {
                    visibles++;
                }

            });



            document.getElementById(
                "contadorCategorias"
            ).textContent =
                visibles;



            btnLimpiarCategoria.style.display =
                filtro
                    ? "flex"
                    : "none";



            const sinResultados =
                document.getElementById(
                    "sinResultadosCategoria"
                );


            if (sinResultados) {

                sinResultados.style.display =
                    visibles === 0
                        ? "flex"
                        : "none";

            }

        }



        function limpiarBusquedaCategoria() {

            inputCategoria.value = "";

            filtrarCategorias();

            inputCategoria.focus();

        }



        btnLimpiarCategoria?.addEventListener(
            "click",
            limpiarBusquedaCategoria
        );



        // =====================================================
        // EVITAR DOBLE GUARDADO
        // =====================================================

        document
            .getElementById(
                "formCategoria"
            )
            ?.addEventListener(
                "submit",
                function () {

                    const boton =
                        document.getElementById(
                            "btnGuardarCategoria"
                        );


                    boton.disabled = true;


                    boton.innerHTML = `

                        <span class="spinner-border spinner-border-sm"></span>

                        Guardando...
                    `;

                }
            );



        // =====================================================
        // MENSAJES
        // =====================================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                @if (TempData["Ok"] != null)
                {
                        <text>

                            Swal.fire({

                                icon:
                                    "success",

                                title:
                                    "Completado",

                                text:
                                    @Html.Raw(
                                            System.Text.Json.JsonSerializer.Serialize(
                                                    TempData["Ok"]
                                            )
                                    ),

                                timer:
                                    1800,

                                showConfirmButton:
                                    false

                            });

                        </text>
                }



                @if (TempData["Error"] != null)
                {
                        <text>

                            Swal.fire({

                                icon:
                                    "error",

                                title:
                                    "No se pudo completar",

                                text:
                                    @Html.Raw(
                                            System.Text.Json.JsonSerializer.Serialize(
                                                    TempData["Error"]
                                            )
                                    )

                            });

                        </text>
                }



                @if (TempData["Editar"] != null)
                {
                        <text>

                            document.getElementById(
                                "modalCategoriaTitulo"
                            ).textContent =
                                "Editar categoría";


                            document.getElementById(
                                "modalCategoriaSubtitulo"
                            ).textContent =
                                "Actualiza la información de la categoría.";


                            document.getElementById(
                                "textoGuardarCategoria"
                            ).textContent =
                                "Guardar cambios";


                            new bootstrap.Modal(
                                document.getElementById(
                                    "modalCategoria"
                                )
                            ).show();

                        </text>
                }


            }
        );


    </script>

}