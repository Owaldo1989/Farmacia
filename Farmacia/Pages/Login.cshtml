@page
@model LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Iniciar sesión | Sistema Farmacia</title>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Fuente -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <!-- CSS DEL LOGIN -->
    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />

</head>

<body>


    <main class="login-page">


        <!-- CAPA OSCURA / BLANCA SOBRE LA FOTO -->
        <div class="background-overlay"></div>


        <!-- =====================================================
             CÁPSULA PRINCIPAL
        ====================================================== -->

        <section class="login-capsule">


            <!-- =================================================
                 LADO IZQUIERDO
            ================================================== -->

            <div class="capsule-brand">


                <div class="brand-icon">

                    <i class="bi bi-capsule"></i>

                </div>


                <h1>
                    SISTEMA FARMACIA
                </h1>


                <p class="brand-description">

                    Tu farmacia más organizada,
                    segura y eficiente.

                </p>


                <!-- CARACTERÍSTICAS -->

                <div class="brand-features">


                    <div class="brand-feature">

                        <i class="bi bi-box-seam"></i>

                        <span>
                            Inventario
                        </span>

                    </div>


                    <div class="brand-divider"></div>


                    <div class="brand-feature">

                        <i class="bi bi-cart3"></i>

                        <span>
                            Ventas
                        </span>

                    </div>


                    <div class="brand-divider"></div>


                    <div class="brand-feature">

                        <i class="bi bi-receipt"></i>

                        <span>
                            Facturación
                        </span>

                    </div>


                </div>


            </div>



            <!-- =================================================
                 LADO DERECHO
            ================================================== -->

            <div class="capsule-login">


                <div class="login-content">


                    <!-- ENCABEZADO -->

                    <div class="login-header">

                        <h2>
                            Bienvenido
                        </h2>

                        <p>
                            Ingresa tus credenciales para continuar
                        </p>

                    </div>


                    <!-- MENSAJE DEL SERVIDOR -->
                    @if (!string.IsNullOrEmpty(Model.Mensaje))
                    {

                        <div class="login-alert">

                            <i class="bi bi-exclamation-circle"></i>

                            <span>
                                @Model.Mensaje
                            </span>

                        </div>

                    }



                    <!-- =============================================
                         FORMULARIO
                    ============================================== -->

                    <form method="post"
                          id="loginForm">


                        <!-- USUARIO -->

                        <div class="form-group">


                            <div class="input-box">


                                <i class="bi bi-person input-icon"></i>


                                <input asp-for="Usuario"
                                       id="txtUsuario"
                                       type="text"
                                       placeholder="Usuario"
                                       autocomplete="username"
                                       required />


                            </div>


                        </div>



                        <!-- CONTRASEÑA -->

                        <div class="form-group">


                            <div class="input-box">


                                <i class="bi bi-lock input-icon"></i>


                                <input asp-for="Clave"
                                       id="txtClave"
                                       type="password"
                                       placeholder="Contraseña"
                                       autocomplete="current-password"
                                       required />


                                <button type="button"
                                        class="show-password"
                                        id="btnMostrarClave"
                                        aria-label="Mostrar contraseña">


                                    <i class="bi bi-eye"
                                       id="iconoClave"></i>


                                </button>


                            </div>


                        </div>



                        <!-- RECORDAR USUARIO -->

                        <div class="login-options">


                            <label class="remember-user">


                                <input type="checkbox"
                                       id="chkRecordar" />


                                <span>
                                    Recordar usuario
                                </span>


                            </label>


                        </div>



                        <!-- BOTÓN -->

                        <button type="submit"
                                class="btn-login"
                                id="btnIngresar">


                            <span class="loader"
                                  id="loader"></span>


                            <i class="bi bi-arrow-right"
                               id="loginIcon"></i>


                            <span id="loginText">

                                Ingresar

                            </span>


                        </button>


                    </form>



                    <!-- SEGURIDAD -->

                    <div class="secure-access">


                        <i class="bi bi-shield-check"></i>


                        <span>
                            Acceso seguro al sistema
                        </span>


                    </div>


                </div>


            </div>


        </section>


    </main>



    <script>


            // =========================================================
            // ELEMENTOS
            // =========================================================

            const txtUsuario =
                document.getElementById("txtUsuario");

            const txtClave =
                document.getElementById("txtClave");

            const chkRecordar =
                document.getElementById("chkRecordar");

            const btnMostrarClave =
                document.getElementById("btnMostrarClave");

            const iconoClave =
                document.getElementById("iconoClave");

            const loginForm =
                document.getElementById("loginForm");

            const btnIngresar =
                document.getElementById("btnIngresar");

            const loginIcon =
                document.getElementById("loginIcon");

            const loginText =
                document.getElementById("loginText");

            const loader =
                document.getElementById("loader");



            // =========================================================
            // MOSTRAR CONTRASEÑA
            // =========================================================

            btnMostrarClave.addEventListener(
                "click",
                function () {

                    if (txtClave.type === "password") {

                        txtClave.type = "text";

                        iconoClave.classList.remove("bi-eye");

                        iconoClave.classList.add("bi-eye-slash");

                    }
                    else {

                        txtClave.type = "password";

                        iconoClave.classList.remove("bi-eye-slash");

                        iconoClave.classList.add("bi-eye");

                    }

                });



            // =========================================================
            // RECORDAR ÚNICAMENTE USUARIO
            // =========================================================

            const usuarioGuardado =
                localStorage.getItem("farmacia_user");


            if (usuarioGuardado) {

                txtUsuario.value =
                    usuarioGuardado;

                chkRecordar.checked =
                    true;

            }



            // =========================================================
            // LOGIN
            // =========================================================

            loginForm.addEventListener(
                "submit",
                function () {


                    // Guardar usuario

                    if (chkRecordar.checked) {

                        localStorage.setItem(
                            "farmacia_user",
                            txtUsuario.value
                        );

                    }
                    else {

                        localStorage.removeItem(
                            "farmacia_user"
                        );

                    }



                    // Mostrar cargando

                    btnIngresar.disabled =
                        true;

                    loader.style.display =
                        "inline-block";

                    loginIcon.style.display =
                        "none";

                    loginText.textContent =
                        "Verificando...";

                });


    </script>


</body>

</html>